    $('shareHint').textContent = '오류 발생';
  }
}

async function captureElements(elementIds) {
  const isLight = document.documentElement.classList.contains('light');
  const bg = isLight ? '#f5f6fa' : '#0f1115';
  const canvases = [];

  for (const id of elementIds) {
    const el = $(id);
    if (!el || el.offsetParent === null) continue;
    const c = await html2canvas(el, {
      backgroundColor: bg,
      scale: 1.5,
      useCORS: true,
      allowTaint: true,
      logging: false,
      foreignObjectRendering: false,
    });
    canvases.push(c);
  }

  if (canvases.length === 0) throw new Error('캡처할 영역이 없습니다');
  if (canvases.length === 1) return addCanvasFooter(canvases[0], isLight, bg);

  // 세로로 합치기
  const padding = 16;
  const maxWidth = Math.max(...canvases.map(c => c.width));
  const footerHeight = 32;
  const totalHeight = canvases.reduce((s, c) => s + c.height + padding, padding) + footerHeight;
  const composite = document.createElement('canvas');
  composite.width = maxWidth;
  composite.height = totalHeight;
  const ctx = composite.getContext('2d');
  ctx.fillStyle = bg;
  ctx.fillRect(0, 0, composite.width, composite.height);

  let y = padding;
  for (const c of canvases) {
    const x = (maxWidth - c.width) / 2;
    ctx.drawImage(c, x, y);
    y += c.height + padding;
  }
  drawFooter(ctx, composite.width, composite.height, isLight);
  return composite;
}

function addCanvasFooter(src, isLight, bg) {
  const footerHeight = 32;
  const composite = document.createElement('canvas');
  composite.width = src.width;
  composite.height = src.height + footerHeight;
  const ctx = composite.getContext('2d');
  ctx.fillStyle = bg;
  ctx.fillRect(0, 0, composite.width, composite.height);
  ctx.drawImage(src, 0, 0);
  drawFooter(ctx, composite.width, composite.height, isLight);
  return composite;
}
function drawFooter(ctx, w, h, isLight) {
  ctx.fillStyle = isLight ? '#5e6470' : '#8a93a6';
  ctx.font = '14px -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif';
  ctx.textAlign = 'center';
  const ts = new Date().toLocaleString('ko-KR');
  ctx.fillText(`📈 ${state.symbol || '종목'} · ${ts} · 투자 참고용, 매매 권유 아님`, w / 2, h - 10);
}

function makeShareFilename() {
  const safe = (state.symbol || 'stock').replace(/[^\w\d가-힣\-]/g, '_');
  const ts = new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-');
  return `${safe}_분석_${ts}.png`;
}
function downloadShareCanvas() {
  if (!lastShareCanvas) return;
  lastShareCanvas.toBlob(blob => {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = makeShareFilename();
    document.body.appendChild(a);
    a.click();
    setTimeout(() => {
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }, 100);
    showToast('💾 다운로드 시작');
  });
}
async function copyShareCanvas() {
  if (!lastShareCanvas) return;
  try {
    if (!navigator.clipboard || !window.ClipboardItem) {
      throw new Error('이 브라우저는 클립보드 이미지 복사를 지원하지 않습니다');
    }
    const blob = await new Promise(r => lastShareCanvas.toBlob(r, 'image/png'));
    await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
    showToast('📋 클립보드에 이미지가 복사되었습니다');
  } catch (e) {
    showToast('❌ 복사 실패: ' + (e.message || '브라우저 미지원'));
  }
}
async function shareCanvasWeb() {
  if (!lastShareCanvas) return;
  try {
    const blob = await new Promise(r => lastShareCanvas.toBlob(r, 'image/png'));
    const file = new File([blob], makeShareFilename(), { type: 'image/png' });
    await navigator.share({
      files: [file],
      title: `${state.symbol || '주식'} 분석 결과`,
      text: `${state.symbol || '종목'} 기술적 분석 결과`,
