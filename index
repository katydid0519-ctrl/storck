// 수수료/거래세 반영 실수익률 계산
// - 매수: 가격 × 수량 × (1 + 수수료%)
// - 매도: 가격 × 수량 × (1 - 수수료% - 거래세%)
function calcNetProfit(buyPrice, sellPrice, qty) {
  const taxPct = userOpts.taxPct || 0;
  const feePct = userOpts.feePct || 0;
  const buyCost = buyPrice * qty * (1 + feePct / 100);
  const sellRevenue = sellPrice * qty * (1 - feePct / 100 - taxPct / 100);
  const netProfit = sellRevenue - buyCost;
  const netPct = buyCost > 0 ? (netProfit / buyCost) * 100 : 0;
  const grossPct = buyPrice > 0 ? (sellPrice - buyPrice) / buyPrice * 100 : 0;
  const totalFees = (buyPrice * qty * feePct / 100) + (sellPrice * qty * (feePct + taxPct) / 100);
  return { buyCost, sellRevenue, netProfit, netPct, grossPct, totalFees };
}
// 각 항목에 net 수익률 미리 계산 (정렬/표시에 공통 사용)
function decorateWithNetPct(it) {
  if (it.position && it.cache?.lastPrice) {
    it._np = calcNetProfit(it.position.avgPrice, it.cache.lastPrice, it.position.quantity);
  }
  return it;
}
