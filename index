function makeSampleKRX() {
  // KRX 형식 모방 — 동작 확인용
  const out = ['일자\t종가\t대비\t등락률\t시가\t고가\t저가\t거래량\t거래대금\t시가총액\t상장주식수'];
  let price = 70000;
  const today = new Date();
  const rows = [];
  for (let i = 250; i >= 0; i--) {
    const d = new Date(today); d.setDate(d.getDate() - i);
    if (d.getDay() === 0 || d.getDay() === 6) continue;
    const o = Math.round(price + (Math.random() - 0.5) * 600);
    const c = Math.round(o + (Math.random() - 0.48) * 1400);
    const h = Math.max(o, c) + Math.round(Math.random() * 400);
    const l = Math.min(o, c) - Math.round(Math.random() * 400);
    const v = Math.round((10000000 + Math.random() * 8000000));
    rows.push({ d, o, c, h, l, v });
    price = c;
  }
  // KRX는 보통 내림차순(최신이 위)
  rows.reverse();
  for (let i = 0; i < rows.length; i++) {
    const r = rows[i];
    const prev = rows[i + 1] ? rows[i + 1].c : r.o;
    const diff = r.c - prev;
    const sign = diff >= 0 ? '▲' : '▼';
    const pct = (diff / prev * 100).toFixed(2);
    const dateStr = r.d.getFullYear() + '/' + String(r.d.getMonth() + 1).padStart(2, '0') + '/' + String(r.d.getDate()).padStart(2, '0');
    out.push([
      dateStr,
      r.c.toLocaleString('en-US'),
      sign + Math.abs(diff).toLocaleString('en-US'),
      (diff >= 0 ? '+' : '') + pct,
      r.o.toLocaleString('en-US'),
      r.h.toLocaleString('en-US'),
      r.l.toLocaleString('en-US'),
      r.v.toLocaleString('en-US'),
      (r.c * r.v).toLocaleString('en-US'),
      (r.c * 5969782550).toLocaleString('en-US'),
      (5969782550).toLocaleString('en-US'),
    ].join('\t'));
  }
  return out.join('\n');
}

