      </div>
      <div class="scroll-x">
        <table class="scenario-table">
          <thead>
            <tr>
              <th>추가 매수 가격<br><span style="font-size:10px;font-weight:400;">(평단 대비)</span></th>
              <th>추가 수량</th>
