/* ============================================================
 *  사용자 설정 (ATR, MA, 손익비, 세금, 알림 등)
 * ========================================================== */
const SETTINGS_OPTS_KEY = 'krx_user_opts_v1';
const DEFAULT_OPTS = {
  atrMult: 2,
  target1Mult: 3,
  target2Mult: 5,
  rrThreshold: 2,
  ma: [5, 20, 60, 120],
  useFee: false,
  taxPct: 0.18,
  feePct: 0.015,
  staleDays: 5,
  alerts: true,
};
let userOpts = { ...DEFAULT_OPTS };

function loadUserOpts() {
  try {
    const saved = JSON.parse(localStorage.getItem(SETTINGS_OPTS_KEY) || '{}');
    userOpts = { ...DEFAULT_OPTS, ...saved };
  } catch (e) { userOpts = { ...DEFAULT_OPTS }; }
}
function saveUserOpts() {
  try { localStorage.setItem(SETTINGS_OPTS_KEY, JSON.stringify(userOpts)); } catch (e) {}
}
function applyOptsToForm() {
  $('set_atrMult').value = userOpts.atrMult;
  $('set_target1Mult').value = userOpts.target1Mult;
  $('set_target2Mult').value = userOpts.target2Mult;
  $('set_rrThreshold').value = userOpts.rrThreshold;
  $('set_ma1').value = userOpts.ma[0];
  $('set_ma2').value = userOpts.ma[1];
  $('set_ma3').value = userOpts.ma[2];
  $('set_ma4').value = userOpts.ma[3];
  $('set_useFee').checked = userOpts.useFee;
  $('set_taxPct').value = userOpts.taxPct;
  $('set_feePct').value = userOpts.feePct;
  $('set_staleDays').value = userOpts.staleDays;
  $('set_alerts').checked = userOpts.alerts;
}
function readOptsFromForm() {
  userOpts.atrMult = parseFloat($('set_atrMult').value) || 2;
  userOpts.target1Mult = parseFloat($('set_target1Mult').value) || 3;
  userOpts.target2Mult = parseFloat($('set_target2Mult').value) || 5;
  userOpts.rrThreshold = parseFloat($('set_rrThreshold').value) || 2;
  userOpts.ma = [
    parseInt($('set_ma1').value) || 5,
    parseInt($('set_ma2').value) || 20,
    parseInt($('set_ma3').value) || 60,
    parseInt($('set_ma4').value) || 120,
  ];
  userOpts.useFee = $('set_useFee').checked;
  userOpts.taxPct = parseFloat($('set_taxPct').value) || 0.18;
  userOpts.feePct = parseFloat($('set_feePct').value) || 0.015;
  userOpts.staleDays = parseInt($('set_staleDays').value) || 5;
