/* 범례 아이템 빌더 */
function legendItem(opts) {
  // opts: { color, label, tip, style: 'solid'|'dashed'|'dotted'|'box' }
  const style = opts.style || 'solid';
  const styleClass = style === 'solid' ? '' : ' ' + style;
  const dot = `<span class="legend-dot${styleClass}" style="background:${style === 'box' || style === 'solid' ? opts.color : 'transparent'}; color:${opts.color}; --dc:${opts.color};"></span>`;
  const tipAttr = opts.tip ? `data-tip="${escapeAttr(opts.tip)}" data-tip-pos="bottom"` : '';
  return `<span class="legend-item" ${tipAttr}>${dot}<b>${escapeHtml(opts.label)}</b></span>`;
}
function escapeAttr(s) {
  return String(s ?? '').replace(/[&<>"'\n]/g, c =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;', '\n': '&#10;' }[c])
  );
}
