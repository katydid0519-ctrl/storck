function syncTimeScale(master, slave) {
  master.timeScale().subscribeVisibleLogicalRangeChange(range => {
    if (range) slave.timeScale().setVisibleLogicalRange(range);
  });
  slave.timeScale().subscribeVisibleLogicalRangeChange(range => {
    if (range) master.timeScale().setVisibleLogicalRange(range);
  });
}
function setupTooltip(chart, data) {
  const tooltip = document.createElement('div');
  tooltip.style.cssText = `
    position: absolute; pointer-events: none; z-index: 100;
    background: var(--panel); color: var(--text);
    border: 1px solid var(--border); border-radius: 6px;
    padding: 6px 8px; font-size: 11px; box-shadow: var(--shadow);
    display: none; white-space: nowrap;
  `;
  $('chartMain').parentElement.style.position = 'relative';
  $('chartMain').parentElement.appendChild(tooltip);

  const byTime = new Map(data.map(d => [d.time, d]));
  chart.subscribeCrosshairMove(param => {
    if (!param.time || !param.point) { tooltip.style.display = 'none'; return; }
    const d = byTime.get(param.time);
    if (!d) { tooltip.style.display = 'none'; return; }
    const chg = d.close - d.open;
    const chgPct = chg / d.open * 100;
    const color = chg >= 0 ? 'var(--up)' : 'var(--down)';
    tooltip.innerHTML = `
      <div style="font-weight:600;">${d.time}</div>
      <div>시: ${fmtNum(d.open)} &nbsp; 고: ${fmtNum(d.high)}</div>
      <div>저: ${fmtNum(d.low)} &nbsp; 종: <span style="color:${color}">${fmtNum(d.close)}</span></div>
      <div>변동: <span style="color:${color}">${fmtPct(chgPct)}</span></div>
      <div>거래량: ${fmtInt(d.volume)}</div>
    `;
    tooltip.style.display = 'block';
    const x = Math.min(param.point.x + 12, $('chartMain').clientWidth - 160);
    const y = Math.max(param.point.y - 70, 8);
    tooltip.style.left = x + 'px';
    tooltip.style.top = y + 'px';
  });
}

