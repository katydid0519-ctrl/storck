  </div>

<script>
'use strict';

/* ============================================================
 *  전역 상태
 * ========================================================== */
const STORAGE_KEY = 'krx_app_settings';
const RAW_KEY = 'krx_app_rawdata';

let state = {
  data: [],            // 봉 종류 적용 후 데이터
  rawDaily: [],        // KRX에서 받은 원본(일봉)
  symbol: '',
  interval: 'DAILY',
  indicators: {
    MA5: true, MA20: true, MA60: true, MA120: false,
    BB: false, VOL: true, RSI: true, MACD: false,
  },
  positionTab: 'summary',
  charts: {},
  series: {},
};

/* ============================================================
 *  유틸
 * ========================================================== */
function $(id) { return document.getElementById(id); }
function showToast(msg, ms = 2400) {
  const t = $('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(showToast._t);
  showToast._t = setTimeout(() => t.classList.remove('show'), ms);
}
function showBanner(msg, type = 'error', isHtml = false) {
  const b = $('banner');
  if (isHtml) b.innerHTML = msg; else b.textContent = msg;
  b.className = 'banner show' + (type === 'warn' ? ' warn' : type === 'info' ? ' info' : '');
  b.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}
function hideBanner() { $('banner').className = 'banner'; }

function fmtNum(n, digits = 2) {
  if (n == null || isNaN(n)) return '-';
  return Number(n).toLocaleString('ko-KR', { maximumFractionDigits: digits, minimumFractionDigits: digits });
}
function fmtInt(n) {
  if (n == null || isNaN(n)) return '-';
  return Math.round(n).toLocaleString('ko-KR');
}
function fmtPct(n, digits = 2) {
  if (n == null || isNaN(n)) return '-';
  return (n >= 0 ? '+' : '') + n.toFixed(digits) + '%';
}
function todayStr() { return new Date().toISOString().slice(0, 10); }
function yearAgoStr() {
  const d = new Date(); d.setFullYear(d.getFullYear() - 1);
  return d.toISOString().slice(0, 10);
}
function escapeHtml(s) {
  return String(s ?? '').replace(/[&<>"']/g, c =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])
  );
}
function avg(arr) { return arr.reduce((s, v) => s + v, 0) / arr.length; }
function daysBetween(a, b) {
  return Math.round((new Date(b).getTime() - new Date(a).getTime()) / 86400000);
}

/* ============================================================
 *  설정 / 데이터 저장
 * ========================================================== */
function loadSettings() {
  try {
    const s = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
    if (s.symbol) $('symbol').value = s.symbol;
    if (s.interval) {
      state.interval = s.interval;
      document.querySelectorAll('#intervalGroup .pill').forEach(p => {
        p.classList.toggle('active', p.dataset.v === s.interval);
      });
    }
    if (s.start) $('startDate').value = s.start;
    if (s.end) $('endDate').value = s.end;
    if (s.theme === 'light') document.documentElement.classList.add('light');
    if (s.indicators) Object.assign(state.indicators, s.indicators);
    refreshIndicatorButtons();
  } catch (e) { /* ignore */ }
  updateThemeBtn();

  if (!$('startDate').value) $('startDate').value = yearAgoStr();
  if (!$('endDate').value) $('endDate').value = todayStr();

  // 마지막 붙여넣은 원문 복원
  try {
    const raw = localStorage.getItem(RAW_KEY);
    if (raw) $('krxInput').value = raw;
  } catch (e) { /* ignore */ }
}
function saveSettings() {
  const s = {
    symbol: $('symbol').value.trim(),
    interval: state.interval,
    start: $('startDate').value,
    end: $('endDate').value,
    theme: document.documentElement.classList.contains('light') ? 'light' : 'dark',
    indicators: state.indicators,
  };
  localStorage.setItem(STORAGE_KEY, JSON.stringify(s));
}
function saveRaw() {
  try { localStorage.setItem(RAW_KEY, $('krxInput').value); } catch (e) { /* ignore */ }
}

/* ============================================================
 *  KRX 표 파서
 *  - 헤더가 한글(일자/종가/시가/고가/저가/거래량…)이어도 자동 인식
 *  - 구분자: 탭(엑셀 복사) 또는 쉼표 자동 감지
 *  - 숫자: 콤마/+/-/▲/▼/%/공백/괄호 정리
 *  - 일자: YYYY/MM/DD, YYYY-MM-DD, YYYY.MM.DD 지원
 * ========================================================== */
function detectSeparator(headerLine) {
  // 엑셀 복사는 탭이 일반적, KRX CSV는 쉼표
  if (headerLine.includes('\t')) return '\t';
  // 컬럼명에 쉼표가 있을 수 있으니 따옴표 안 쉼표 무시는 단순 split으로 처리
  return ',';
}
function splitLine(line, sep) {
  // 따옴표 처리 (KRX 엑셀은 보통 따옴표 없음)
  if (sep === ',') {
    const out = []; let cur = ''; let inQ = false;
    for (let i = 0; i < line.length; i++) {
      const c = line[i];
      if (c === '"') { inQ = !inQ; continue; }
      if (c === ',' && !inQ) { out.push(cur); cur = ''; }
      else cur += c;
    }
    out.push(cur);
    return out;
  }
  return line.split(sep);
}
function cleanNum(s) {
  if (s == null) return NaN;
  let str = String(s).trim().replace(/^"|"$/g, '');
  if (!str || str === '-') return NaN;
  let neg = false;
  if (str.includes('▼')) neg = true;
  if (str.startsWith('(') && str.endsWith(')')) neg = true;
  str = str.replace(/[▲▼+,%\s()]/g, '');
  if (str.startsWith('-')) { neg = true; str = str.slice(1); }
  const n = parseFloat(str);
  if (isNaN(n)) return NaN;
  return neg ? -n : n;
}
function normalizeDate(s) {
  if (!s) return '';
  const str = String(s).trim().replace(/^"|"$/g, '');
  const m = str.match(/^(\d{4})[\/.\-](\d{1,2})[\/.\-](\d{1,2})/);
  if (m) return `${m[1]}-${m[2].padStart(2, '0')}-${m[3].padStart(2, '0')}`;
  const m2 = str.match(/^(\d{8})$/);
  if (m2) return `${str.slice(0, 4)}-${str.slice(4, 6)}-${str.slice(6, 8)}`;
  return '';
}
function parseKRX(text) {
  const lines = text.replace(/﻿/g, '').split(/\r?\n/).map(l => l.trim()).filter(l => l);
  if (lines.length < 2) throw new Error('데이터가 부족합니다. 헤더 + 1행 이상이 필요합니다.');

  const sep = detectSeparator(lines[0]);
  const headers = splitLine(lines[0], sep).map(h => h.trim().replace(/\s+/g, ''));

  // 컬럼 별명 (한글/영문 모두 대응)
  const ALIASES = {
    date:   ['일자', '날짜', '거래일', 'Date', 'date'],
    close:  ['종가', 'Close', 'close', '현재가'],
    open:   ['시가', 'Open', 'open'],
    high:   ['고가', 'High', 'high'],
    low:    ['저가', 'Low', 'low'],
    volume: ['거래량', 'Volume', 'volume'],
    change: ['대비', '전일대비'],
    chgPct: ['등락률(%)', '등락률', '등락', 'ChangePct'],
    amount: ['거래대금'],
    mcap:   ['시가총액'],
    shares: ['상장주식수'],
  };
  function findIdx(keys) {
    for (const k of keys) {
      const i = headers.findIndex(h => h === k || h.replace(/[\s()%]/g, '') === k.replace(/[\s()%]/g, ''));
      if (i >= 0) return i;
    }
    return -1;
  }
  const idx = {};
  for (const k in ALIASES) idx[k] = findIdx(ALIASES[k]);

  // 첫 줄이 헤더가 아닌 경우 — 사용자에게 명확한 메시지
  if (idx.date < 0 || idx.close < 0 || idx.open < 0 || idx.high < 0 || idx.low < 0) {
    throw new Error(
      '필수 컬럼(일자/시가/고가/저가/종가)을 찾을 수 없습니다.\n' +
      '첫 줄이 헤더(일자, 종가, 대비, 등락률, 시가, 고가, 저가, 거래량 …)인지 확인하세요.\n' +
      '감지된 헤더: ' + headers.slice(0, 12).join(' | ')
    );
  }

  const rows = [];
  for (let i = 1; i < lines.length; i++) {
    const c = splitLine(lines[i], sep);
    if (c.length < 4) continue;
    const date = normalizeDate(c[idx.date]);
    if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) continue;
    const open = cleanNum(c[idx.open]);
    const high = cleanNum(c[idx.high]);
    const low = cleanNum(c[idx.low]);
    const close = cleanNum(c[idx.close]);
    const volume = idx.volume >= 0 ? cleanNum(c[idx.volume]) : 0;
    if ([open, high, low, close].some(v => isNaN(v) || v <= 0)) continue;
    rows.push({
      time: date,
      open, high, low, close,
      volume: isNaN(volume) ? 0 : Math.max(0, volume),
    });
  }
  if (rows.length === 0) {
    throw new Error('유효한 데이터 행을 찾지 못했습니다. 숫자 포맷을 확인해주세요.');
  }
  // 오름차순 정렬 + 중복 제거
  rows.sort((a, b) => a.time.localeCompare(b.time));
  const out = [];
  for (const r of rows) {
    if (out.length && out[out.length - 1].time === r.time) continue;
    out.push(r);
  }
  return out;
}

/* ============================================================
 *  봉 종류 리샘플링 (일봉 → 주봉/월봉)
 * ========================================================== */
function resample(data, interval) {
  if (interval === 'DAILY' || data.length === 0) return data;
  const groups = new Map();
  for (const r of data) {
    let key;
    const d = new Date(r.time);
    if (interval === 'WEEKLY') {
      // 해당 주의 월요일
      const day = d.getDay(); // 0(일) ~ 6(토)
      const diff = day === 0 ? 6 : day - 1;
      const monday = new Date(d); monday.setDate(d.getDate() - diff);
      key = monday.toISOString().slice(0, 10);
    } else {
      key = r.time.slice(0, 7) + '-01';
    }
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key).push(r);
  }
  const out = [];
  for (const [key, rows] of [...groups.entries()].sort()) {
    rows.sort((a, b) => a.time.localeCompare(b.time));
    out.push({
      time: key,
      open: rows[0].open,
      high: Math.max(...rows.map(r => r.high)),
      low:  Math.min(...rows.map(r => r.low)),
      close: rows[rows.length - 1].close,
      volume: rows.reduce((s, r) => s + r.volume, 0),
    });
  }
  return out;
}
function filterByDate(rows, start, end) {
  return rows.filter(r => (!start || r.time >= start) && (!end || r.time <= end));
}

/* ============================================================
 *  지표 계산
 * ========================================================== */
function calcMA(data, period) {
  const out = []; let sum = 0;
  for (let i = 0; i < data.length; i++) {
    sum += data[i].close;
    if (i >= period) sum -= data[i - period].close;
    if (i >= period - 1) out.push({ time: data[i].time, value: sum / period });
  }
  return out;
}
function calcStd(data, period) {
  const out = [];
  for (let i = period - 1; i < data.length; i++) {
    let sum = 0;
    for (let j = i - period + 1; j <= i; j++) sum += data[j].close;
    const mean = sum / period;
    let sq = 0;
    for (let j = i - period + 1; j <= i; j++) sq += (data[j].close - mean) ** 2;
    out.push({ time: data[i].time, mean, std: Math.sqrt(sq / period) });
  }
  return out;
}
function calcBollinger(data, period = 20, mult = 2) {
  const stds = calcStd(data, period);
  return {
    upper: stds.map(s => ({ time: s.time, value: s.mean + mult * s.std })),
    lower: stds.map(s => ({ time: s.time, value: s.mean - mult * s.std })),
    mid:   stds.map(s => ({ time: s.time, value: s.mean })),
  };
}
function calcRSI(data, period = 14) {
  if (data.length <= period) return [];
  const out = []; let gain = 0, loss = 0;
  for (let i = 1; i <= period; i++) {
    const d = data[i].close - data[i - 1].close;
    if (d > 0) gain += d; else loss -= d;
  }
  gain /= period; loss /= period;
  let rs = loss === 0 ? Infinity : gain / loss;
  out.push({ time: data[period].time, value: loss === 0 ? 100 : 100 - 100 / (1 + rs) });
  for (let i = period + 1; i < data.length; i++) {
    const d = data[i].close - data[i - 1].close;
    const g = d > 0 ? d : 0, l = d < 0 ? -d : 0;
    gain = (gain * (period - 1) + g) / period;
    loss = (loss * (period - 1) + l) / period;
    rs = loss === 0 ? Infinity : gain / loss;
    out.push({ time: data[i].time, value: loss === 0 ? 100 : 100 - 100 / (1 + rs) });
  }
  return out;
}
function calcEMA(values, period) {
  if (values.length < period) return [];
  const k = 2 / (period + 1); const out = [];
  let ema = 0;
  for (let i = 0; i < period; i++) ema += values[i].value;
  ema /= period;
  out.push({ time: values[period - 1].time, value: ema });
  for (let i = period; i < values.length; i++) {
    ema = values[i].value * k + ema * (1 - k);
    out.push({ time: values[i].time, value: ema });
  }
  return out;
}
function calcMACD(data, fast = 12, slow = 26, signal = 9) {
  const closes = data.map(d => ({ time: d.time, value: d.close }));
  const emaFast = calcEMA(closes, fast);
  const emaSlow = calcEMA(closes, slow);
  const map = new Map(emaSlow.map(d => [d.time, d.value]));
  const macd = emaFast.filter(d => map.has(d.time))
    .map(d => ({ time: d.time, value: d.value - map.get(d.time) }));
  const signalLine = calcEMA(macd, signal);
  const sigMap = new Map(signalLine.map(d => [d.time, d.value]));
  const hist = macd.filter(d => sigMap.has(d.time))
    .map(d => ({ time: d.time, value: d.value - sigMap.get(d.time) }));
  return { macd, signal: signalLine, hist };
}
function calcATR(data, period = 14) {
  if (data.length < period + 1) return [];
  const trs = [];
  for (let i = 1; i < data.length; i++) {
    const h = data[i].high, l = data[i].low, pc = data[i - 1].close;
    trs.push({ time: data[i].time, value: Math.max(h - l, Math.abs(h - pc), Math.abs(l - pc)) });
  }
  const out = []; let atr = 0;
  for (let i = 0; i < period; i++) atr += trs[i].value;
  atr /= period;
  out.push({ time: trs[period - 1].time, value: atr });
  for (let i = period; i < trs.length; i++) {
    atr = (atr * (period - 1) + trs[i].value) / period;
    out.push({ time: trs[i].time, value: atr });
  }
  return out;
}

/* ============================================================
 *  자동 분석: 시그널
 * ========================================================== */
function detectSignals(data) {
  const signals = [];
  if (data.length < 25) return signals;

  const ma5 = calcMA(data, 5);
  const ma20 = calcMA(data, 20);
  const rsi = calcRSI(data, 14);
  const bb = calcBollinger(data, 20, 2);
  const macd = calcMACD(data);

  // 1) 골든/데드크로스
  const m5Map = new Map(ma5.map(d => [d.time, d.value]));
  const aligned = ma20.filter(d => m5Map.has(d.time))
    .map(d => ({ time: d.time, m5: m5Map.get(d.time), m20: d.value }));
  let lastCross = null;
  for (let i = 1; i < aligned.length; i++) {
    const p = aligned[i - 1], c = aligned[i];
    if (p.m5 <= p.m20 && c.m5 > c.m20) lastCross = { type: 'golden', date: c.time };
    if (p.m5 >= p.m20 && c.m5 < c.m20) lastCross = { type: 'dead', date: c.time };
  }
  if (lastCross) {
    const daysAgo = daysBetween(lastCross.date, data[data.length - 1].time);
    if (lastCross.type === 'golden') {
      signals.push({
        type: 'good',
        title: '🌟 골든크로스 발생',
        desc: `${lastCross.date} (${daysAgo}일 전) 단기선(MA5)이 중기선(MA20) 위로 돌파`,
        helper: '💡 단기 추세가 중기 추세를 뚫고 올라가는 상승 전환 신호입니다. 발생 직후라면 매수 관심 시점입니다.'
      });
    } else {
      signals.push({
        type: 'bad',
        title: '☠️ 데드크로스 발생',
        desc: `${lastCross.date} (${daysAgo}일 전) 단기선(MA5)이 중기선(MA20) 아래로 이탈`,
        helper: '⚠️ 단기 추세가 꺾이는 하락 전환 신호입니다. 보유 중이라면 비중 축소를 검토하세요.'
      });
    }
  }

  // 2) RSI
  if (rsi.length > 0) {
    const v = rsi[rsi.length - 1].value;
    if (v > 70) signals.push({
      type: 'warn', title: '🔥 RSI 과매수 구간',
      desc: `현재 ${v.toFixed(1)} (70 초과)`,
      helper: '💡 단기간 너무 빠르게 올라 조정 가능성이 있는 구간입니다. 신규 매수는 신중히, 보유자는 일부 차익실현을 고려해보세요.'
    });
    else if (v < 30) signals.push({
      type: 'good', title: '💧 RSI 과매도 구간',
      desc: `현재 ${v.toFixed(1)} (30 미만)`,
      helper: '💡 단기 낙폭이 과도해 기술적 반등 가능성이 있는 구간입니다. 다만 추세가 명확히 하락 중이면 추가 하락 위험도 있으니 다른 지표와 함께 확인하세요.'
    });
    else signals.push({
      type: '', title: '⚖️ RSI 중립',
      desc: `현재 ${v.toFixed(1)} (정상 범위)`,
      helper: '💡 30~70 사이의 정상 구간입니다. 추세를 따라 안정적인 흐름을 보이고 있습니다.'
    });
  }

  // 3) 볼린저 밴드
  if (bb.upper.length > 0) {
    const c = data[data.length - 1].close;
    const u = bb.upper[bb.upper.length - 1].value;
    const l = bb.lower[bb.lower.length - 1].value;
    if (c >= u * 0.995) signals.push({
      type: 'warn', title: '📈 볼린저 상단 접근',
      desc: `상단 ${fmtNum(u)} vs 종가 ${fmtNum(c)}`,
      helper: '💡 가격이 통계적 상단 한계에 가까워졌습니다. 추세가 강하면 더 오를 수도 있지만, 단기 조정 가능성이 높아진 상태입니다.'
    });
    else if (c <= l * 1.005) signals.push({
      type: 'good', title: '📉 볼린저 하단 접근',
      desc: `하단 ${fmtNum(l)} vs 종가 ${fmtNum(c)}`,
      helper: '💡 가격이 통계적 하단에 도달했습니다. 분할 매수 관점에서 관심 구간이지만, 추세 자체가 하락 중이면 더 떨어질 수 있습니다.'
    });
  }

  // 4) MACD
  if (macd.macd.length > 2 && macd.signal.length > 2) {
    const mMap = new Map(macd.macd.map(d => [d.time, d.value]));
    const sMap = new Map(macd.signal.map(d => [d.time, d.value]));
    const times = macd.signal.map(d => d.time).filter(t => mMap.has(t));
    let last = null;
    for (let i = 1; i < times.length; i++) {
      const pM = mMap.get(times[i - 1]), pS = sMap.get(times[i - 1]);
      const cM = mMap.get(times[i]),     cS = sMap.get(times[i]);
      if (pM <= pS && cM > cS) last = { type: 'up', date: times[i] };
      if (pM >= pS && cM < cS) last = { type: 'down', date: times[i] };
    }
    if (last) {
      const days = daysBetween(last.date, data[data.length - 1].time);
      if (last.type === 'up') signals.push({
        type: 'good', title: '📈 MACD 매수 신호',
        desc: `${last.date} (${days}일 전) MACD선이 시그널선 상향 돌파`,
        helper: '💡 추세 전환 모멘텀이 살아나는 신호입니다. 골든크로스와 함께 발생하면 더 강한 매수 신호로 봅니다.'
      });
      else signals.push({
        type: 'bad', title: '📉 MACD 매도 신호',
        desc: `${last.date} (${days}일 전) MACD선이 시그널선 하향 돌파`,
        helper: '⚠️ 상승 모멘텀이 약화되는 신호입니다. 단기 차익실현 또는 손절 라인 재점검을 고려하세요.'
      });
    }
  }

  // 5) 거래량
  if (data.length >= 25 && data.some(d => d.volume > 0)) {
    const v5 = avg(data.slice(-5).map(d => d.volume));
    const v20 = avg(data.slice(-20).map(d => d.volume));
    if (v20 > 0) {
      const ratio = v5 / v20;
      if (ratio > 1.5) signals.push({
        type: 'warn', title: '🔊 거래량 급증',
        desc: `최근 5일 평균이 20일 평균의 ${ratio.toFixed(2)}배`,
        helper: '💡 시장의 관심이 쏠리고 있습니다. 상승과 함께라면 추세 강화 신호, 하락과 함께라면 투매 가능성. 가격 방향과 함께 봐야 합니다.'
      });
      else if (ratio < 0.6) signals.push({
        type: '', title: '🔇 거래량 위축',
        desc: `최근 5일 평균이 20일 평균의 ${ratio.toFixed(2)}배`,
        helper: '💡 시장 관심이 식어가는 상태. 큰 변동이 적고 박스권에 갇혀 있을 가능성이 큽니다.'
      });
    }
  }
  return signals;
}

/* ============================================================
 *  매매 가이드 계산 (분할 매수, 손절, 목표가, 손익비)
 * ========================================================== */
function calcTradingLevels(data) {
  if (data.length < 10) return null;
  const last = data[data.length - 1];

  const atrSeries = calcATR(data, 14);
  const atr = atrSeries.length ? atrSeries[atrSeries.length - 1].value : last.close * 0.02;

  const ma20S = calcMA(data, 20);
  const ma20 = ma20S.length ? ma20S[ma20S.length - 1].value : last.close;
  const ma60S = calcMA(data, Math.min(60, data.length - 1));
  const ma60 = ma60S.length ? ma60S[ma60S.length - 1].value : last.close;

  const bb = calcBollinger(data, 20, 2);
  const bbLast = bb.upper.length ? {
    upper: bb.upper[bb.upper.length - 1].value,
    mid:   bb.mid[bb.mid.length - 1].value,
    lower: bb.lower[bb.lower.length - 1].value,
  } : null;

  const r52 = data.slice(-Math.min(252, data.length));
  const high52w = Math.max(...r52.map(d => d.high));
  const low52w = Math.min(...r52.map(d => d.low));
  const pos52w = (last.close - low52w) / Math.max(1, (high52w - low52w)) * 100;

  const r20 = data.slice(-Math.min(20, data.length));
  const high20 = Math.max(...r20.map(d => d.high));
  const low20 = Math.min(...r20.map(d => d.low));
  const r60 = data.slice(-Math.min(60, data.length));
  const high60 = Math.max(...r60.map(d => d.high));
  const low60 = Math.min(...r60.map(d => d.low));

  // 분할 매수가 (3단계)
  //  1차: 현재가 (즉시) — 추세 추격
  //  2차: -3% 조정 또는 MA20
  //  3차: 강한 지지(볼린저 하단 또는 피보 38.2% 또는 최근 저점 근처)
  const range60 = high60 - low60;
  const fib382 = low60 + range60 * 0.382;
  const buy1 = Math.round(last.close);
  const buy2 = Math.round(Math.min(last.close * 0.97, ma20));
  const buy3Candidate = Math.min(
    last.close * 0.93,
    bbLast ? bbLast.lower : last.close - atr * 2,
    fib382,
    low20 * 1.01
  );
  const buy3 = Math.round(Math.max(buy3Candidate, low52w));
  const avgBuy = buy1 * 0.4 + buy2 * 0.35 + buy3 * 0.25;

  // 손절가: max(평단 - ATR * 사용자배수, 최근 저점 * 0.98)
  const stopLoss = Math.round(Math.min(avgBuy - atr * userOpts.atrMult, low20 * 0.98));

  // 목표가 (사용자 ATR 배수 사용)
  const target1 = Math.round(Math.max(high20 * 1.005, last.close + atr * userOpts.target1Mult));
  const target2 = Math.round(Math.max(high60 * 1.01, last.close + atr * userOpts.target2Mult));

  // 손익비
  const risk = avgBuy - stopLoss;
  const rwd1 = target1 - avgBuy;
  const rwd2 = target2 - avgBuy;
  const rr1 = risk > 0 ? rwd1 / risk : 0;
  const rr2 = risk > 0 ? rwd2 / risk : 0;

  return {
    current: last.close,
    splitBuy: [
      { price: buy1, pct: 40, label: '1차 (즉시 매수)', desc: '현재가 기준 — 추세 추격' },
      { price: buy2, pct: 35, label: '2차 (단기 조정 시)', desc: `-3% 또는 MA20(${fmtNum(ma20, 0)}) 근처` },
      { price: buy3, pct: 25, label: '3차 (강한 지지)', desc: `볼린저 하단 / 피보 38.2% (${fmtNum(fib382, 0)})` },
    ],
    avgBuy: Math.round(avgBuy),
    stopLoss,
    stopLossPct: (stopLoss - last.close) / last.close * 100,
    target1, target1Pct: (target1 - last.close) / last.close * 100,
    target2, target2Pct: (target2 - last.close) / last.close * 100,
    risk, rwd1, rwd2, rr1, rr2,
    high52w, low52w, pos52w,
    high20, low20, high60, low60,
    fib382, atr, ma20, ma60, bb: bbLast,
  };
}

/* ============================================================
 *  종합 점수 (0~100, 4 카테고리)
 * ========================================================== */
function calcScore(data) {
  const out = { total: 50, breakdown: [] };
  if (data.length < 20) return out;

  // 1) 추세 (0~25)
  let trend = 12.5, trendDesc = '판단 불가';
  const ma20 = calcMA(data, 20);
  const ma60 = calcMA(data, Math.min(60, data.length - 1));
  if (ma20.length >= 10) {
    const slope = (ma20[ma20.length - 1].value - ma20[ma20.length - 10].value) / ma20[ma20.length - 10].value * 100;
    trend = Math.max(0, Math.min(25, 12.5 + slope * 2.5));
    if (ma60.length > 0 && ma20[ma20.length - 1].value > ma60[ma60.length - 1].value) trend = Math.min(25, trend + 3);
    trendDesc = slope > 3 ? '강한 상승추세 ↑↑' : slope > 0 ? '완만한 상승 ↑' : slope > -3 ? '횡보/약세 →' : '하락추세 ↓↓';
  }

  // 2) 모멘텀 RSI (0~25)
  let mom = 12.5, momDesc = '-';
  const rsi = calcRSI(data, 14);
  if (rsi.length > 0) {
    const v = rsi[rsi.length - 1].value;
    if (v < 30) { mom = 22; momDesc = `RSI ${v.toFixed(0)} — 과매도 반등 기대`; }
    else if (v < 45) { mom = 17; momDesc = `RSI ${v.toFixed(0)} — 약세 모멘텀`; }
    else if (v < 55) { mom = 18; momDesc = `RSI ${v.toFixed(0)} — 중립`; }
    else if (v < 70) { mom = 20; momDesc = `RSI ${v.toFixed(0)} — 양호`; }
    else { mom = 8; momDesc = `RSI ${v.toFixed(0)} — 과매수 주의`; }
  }

  // 3) 안정성 (변동성 낮을수록 높음, 0~25)
  let stab = 12.5, stabDesc = '-';
  const last20 = data.slice(-20).map(d => d.close);
  const m = avg(last20);
  const std = Math.sqrt(last20.reduce((s, v) => s + (v - m) ** 2, 0) / last20.length);
  const volPct = std / m * 100;
  stab = Math.max(0, Math.min(25, 25 - volPct * 0.8));
  stabDesc = volPct < 1.5 ? '매우 안정적' : volPct < 3 ? '안정적' : volPct < 5 ? '보통' : volPct < 8 ? '변동 큼' : '매우 변동성 큼';

  // 4) 거래량 (0~25)
  let vol = 12.5, volDesc = '-';
  if (data.some(d => d.volume > 0)) {
    const v5 = avg(data.slice(-5).map(d => d.volume));
    const v20 = avg(data.slice(-20).map(d => d.volume));
    if (v20 > 0) {
      const ratio = v5 / v20;
      if (ratio > 1.5) { vol = 22; volDesc = `5일 평균 ${ratio.toFixed(2)}× — 관심 급증`; }
      else if (ratio > 0.9) { vol = 18; volDesc = `5일 평균 ${ratio.toFixed(2)}× — 정상`; }
      else if (ratio > 0.6) { vol = 13; volDesc = `5일 평균 ${ratio.toFixed(2)}× — 다소 위축`; }
      else { vol = 8; volDesc = `5일 평균 ${ratio.toFixed(2)}× — 관심 식음`; }
    }
  }

  const total = Math.round(trend + mom + stab + vol);
  return {
    total,
    trendSlopePct: ma20.length >= 10 ? ((ma20[ma20.length - 1].value - ma20[ma20.length - 10].value) / ma20[ma20.length - 10].value * 100) : 0,
    volPct,
    breakdown: [
      { name: '추세', score: trend, max: 25, desc: trendDesc, color: '#3b82f6' },
      { name: '모멘텀', score: mom, max: 25, desc: momDesc, color: '#eab308' },
      { name: '안정성', score: stab, max: 25, desc: stabDesc, color: '#10b981' },
      { name: '거래량', score: vol, max: 25, desc: volDesc, color: '#a855f7' },
    ],
  };
}

function generateVerdict(data, signals, scoreObj) {
  const reasons = []; let score = 0;
  const ma20 = calcMA(data, 20);
  if (ma20.length >= 10) {
    const slope = ma20[ma20.length - 1].value - ma20[ma20.length - 10].value;
    const slopePct = slope / ma20[ma20.length - 10].value * 100;
    if (slopePct > 3) { score += 2; reasons.push(`MA20 기울기 +${slopePct.toFixed(1)}% → 명확한 상승추세`); }
    else if (slopePct < -3) { score -= 2; reasons.push(`MA20 기울기 ${slopePct.toFixed(1)}% → 명확한 하락추세`); }
    else { reasons.push(`MA20 기울기 ${slopePct.toFixed(1)}% → 횡보 구간`); }
  }
  const rsi = calcRSI(data, 14);
  if (rsi.length > 0) {
    const v = rsi[rsi.length - 1].value;
    if (v > 70) { score -= 1; reasons.push(`RSI ${v.toFixed(1)} — 과매수, 조정 위험`); }
    else if (v < 30) { score += 1; reasons.push(`RSI ${v.toFixed(1)} — 과매도, 반등 여지`); }
    else { reasons.push(`RSI ${v.toFixed(1)} — 중립 범위`); }
  }
  if (signals.some(s => s.title.includes('골든크로스'))) { score += 1.5; reasons.push('최근 골든크로스 발생 → 매수 모멘텀'); }
  if (signals.some(s => s.title.includes('데드크로스'))) { score -= 1.5; reasons.push('최근 데드크로스 발생 → 매도 모멘텀'); }
  if (signals.some(s => s.title.includes('MACD 매수'))) { score += 1; }
  if (signals.some(s => s.title.includes('MACD 매도'))) { score -= 1; }

  let verdict, vColor, vDesc, vEmoji;
  if (score >= 3) {
    vEmoji = '🟢'; verdict = '적극 매수 관심'; vColor = 'var(--good)';
    vDesc = '여러 지표가 상승 신호를 보이고 있습니다. 분할 매수 전략으로 진입을 고려해볼 수 있는 구간입니다. 단, 시장 전체 분위기와 종목 펀더멘털(실적·재무)도 반드시 함께 확인하세요.';
  } else if (score >= 1.5) {
    vEmoji = '🟢'; verdict = '매수 관심'; vColor = 'var(--good)';
    vDesc = '기술적으로 우호적인 환경입니다. 적극적이기보다 분할 매수로 신중히 접근하는 것이 좋습니다.';
  } else if (score <= -3) {
    vEmoji = '🔴'; verdict = '매도 검토'; vColor = 'var(--bad)';
    vDesc = '여러 지표가 하락을 가리키고 있습니다. 보유 중이라면 손절가 재점검과 비중 축소를 고려하세요. 신규 매수는 추세 전환을 확인 후 검토하는 것이 안전합니다.';
  } else if (score <= -1.5) {
    vEmoji = '🟠'; verdict = '관망 (약세)'; vColor = 'var(--warn)';
    vDesc = '단기 약세 신호가 보입니다. 추격 매수보다는 추세 반전 신호를 기다리는 것이 좋습니다.';
  } else {
    vEmoji = '🟡'; verdict = '관망'; vColor = 'var(--warn)';
    vDesc = '뚜렷한 방향성이 없는 구간입니다. 박스권 횡보 가능성이 높으니 명확한 신호가 나올 때까지 기다리거나, 짧은 단타로만 접근하세요.';
  }
  return { verdict, vColor, vDesc, vEmoji, reasons: reasons.slice(0, 4), score };
}
function trendName(data) {
  const ma20 = calcMA(data, 20);
  const ma60 = calcMA(data, Math.min(60, data.length - 1));
  if (ma20.length < 10 || ma60.length < 10) return '데이터 부족';
  const s20 = ma20[ma20.length - 1].value - ma20[ma20.length - 10].value;
  const s60 = ma60[ma60.length - 1].value - ma60[ma60.length - 10].value;
  if (s20 > 0 && s60 > 0) return '상승추세';
  if (s20 < 0 && s60 < 0) return '하락추세';
  return '횡보';
}

