  `;
}

/* --- 커스텀 추가 매수 즉시 계산 --- */
function updateCustomAddBuy() {
  const result = $('customAddResult');
  if (!result) return;

  const avgPrice = parseFloat($('pos_avgPrice').value);
  const qty = parseFloat($('pos_quantity').value);
  if (isNaN(avgPrice) || isNaN(qty) || !state.data.length) {
    result.innerHTML = '<span style="color:var(--muted);">평균 매수가와 보유 수량을 먼저 입력하세요.</span>';
    return;
  }

  const addPrice = parseFloat($('customAddPrice').value);
  const addQty = parseFloat($('customAddQty').value);
  if (isNaN(addPrice) || isNaN(addQty) || addPrice <= 0 || addQty <= 0) {
    result.innerHTML = '<span style="color:var(--muted);">위 두 값을 입력하면 새 평단·합계 수량·손익률이 자동 계산됩니다.</span>';
    return;
  }

  const current = state.data[state.data.length - 1].close;
  const newQty = qty + addQty;
  const newAvg = (avgPrice * qty + addPrice * addQty) / newQty;
  const newAvgChangePct = (newAvg - avgPrice) / avgPrice * 100;
  const newPlPct = (current - newAvg) / newAvg * 100;
  const oldPlPct = (current - avgPrice) / avgPrice * 100;
  const addCost = addPrice * addQty;
  const totalCost = avgPrice * qty + addCost;
  const discountFromAvg = (addPrice - avgPrice) / avgPrice * 100;

  const cls = newPlPct >= 0 ? 'pos' : 'neg';
  const oldCls = oldPlPct >= 0 ? 'pos' : 'neg';
  const avgCls = newAvgChangePct < 0 ? 'pos' : 'neg';
  const discCls = discountFromAvg < 0 ? 'pos' : 'neg';

  result.innerHTML = `
    💡 <b>${fmtNum(addPrice, 0)}원 × ${fmtInt(addQty)}주 = ${fmtNum(addCost, 0)}원</b> 추가 매수 시:
    <br>→ 추가 매수가 vs 평단: <b class="${discCls}">${fmtPct(discountFromAvg)}</b>
    <br>→ 새 평단: <b>${fmtNum(newAvg, 0)}원</b> (기존 ${fmtNum(avgPrice, 0)} → <b class="${avgCls}">${fmtPct(newAvgChangePct)}</b>)
    <br>→ 합계 수량: <b>${fmtInt(newQty)}주</b> · 총 투자금: <b>${fmtNum(totalCost, 0)}원</b>
    <br>→ 현재가(${fmtNum(current, 0)}) 기준 손익률: <b class="${oldCls}">${fmtPct(oldPlPct)}</b> → <b class="${cls}">${fmtPct(newPlPct)}</b>
  `;
}

