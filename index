    btn.onclick = () => {
      document.querySelectorAll('#posSidebar .pos-sidebar-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      state.positionTab = btn.dataset.tab;
      if (state.data.length > 0) renderPositionSection();
    };
  });

  // 커스텀 추가 매수 입력 (innerHTML로 새로 그려지므로 위임)
  document.body.addEventListener('input', (e) => {
    if (e.target && (e.target.id === 'customAddPrice' || e.target.id === 'customAddQty')) {
      updateCustomAddBuy();
    }
  });

  // 빠른 입력 모달
  $('quickEntryBtn').onclick = openQuickModal;
  $('quickCloseBtn').onclick = closeQuickModal;
  $('quickCancelBtn').onclick = closeQuickModal;
  $('quickApplyBtn').onclick = applyQuickEntry;
  $('quickModal').addEventListener('click', (e) => {
    if (e.target.id === 'quickModal') closeQuickModal();
  });

  // 포지션 분석 모달
  $('positionBtn').onclick = openPositionModal;
  $('positionCloseBtn').onclick = closePositionModal;
  $('positionModal').addEventListener('click', (e) => {
    if (e.target.id === 'positionModal') closePositionModal();
  });

  // 카드 접힘 토글
  bindCollapsible();
  $('collapseAllBtn').onclick = toggleAllCollapsibles;

  // 스크롤 이동 핸들
  $('scrollTopBtn').onclick = () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };
  $('scrollBottomBtn').onclick = () => {
    window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'smooth' });
  };
  // 스크롤 위치에 따라 핸들 활성/비활성
  const updateScrollHandles = () => {
    const y = window.scrollY || window.pageYOffset;
    const max = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
    $('scrollTopBtn').classList.toggle('disabled', y < 60);
    $('scrollBottomBtn').classList.toggle('disabled', y >= max - 60);
  };
  window.addEventListener('scroll', updateScrollHandles, { passive: true });
  window.addEventListener('resize', updateScrollHandles);
  updateScrollHandles();

  // ─── 설정 모달 ───
  $('settingsBtn').onclick = openSettingsModal;
  $('settingsCloseBtn').onclick = closeSettingsModal;
  $('settingsApplyBtn').onclick = applySettingsAndRerun;
  $('settingsResetBtn').onclick = resetSettings;
  $('enableNotifBtn').onclick = requestNotifPermission;
  $('settingsModal').addEventListener('click', (e) => {
    if (e.target.id === 'settingsModal') closeSettingsModal();
  });

  // ─── 워치리스트 모달 ───
  $('watchlistBtn').onclick = openWatchlistModal;
  $('watchlistCloseBtn').onclick = closeWatchlistModal;
  $('watchlistModal').addEventListener('click', (e) => {
    if (e.target.id === 'watchlistModal') closeWatchlistModal();
  });
  $('compareToggle').onclick = toggleCompareMode;
  document.querySelectorAll('#watchlistModal [data-sort]').forEach(btn => {
    btn.onclick = () => { watchSortMode = btn.dataset.sort; renderWatchlist(); };
  });
  $('watchlistGrid').addEventListener('click', (e) => {
    const card = e.target.closest('.watch-card');
    if (card) clickWatchCard(card.dataset.id);
  });

  // ─── 비교 모달 ───
  $('compareCloseBtn').onclick = closeCompareModal;
  $('compareModal').addEventListener('click', (e) => {
    if (e.target.id === 'compareModal') closeCompareModal();
  });

  // ─── 도움말 투어 ───
  $('tourBtn').onclick = openTour;
  $('tourNextBtn').onclick = nextTourStep;
  $('tourSkipBtn').onclick = closeTour;

  // ─── 인쇄 ───
  $('printBtn').onclick = () => {
    if (!state.data.length) { showBanner('먼저 분석을 실행해주세요.', 'warn'); return; }
    window.print();
  };

  // ─── KRX 직링크 ───
  $('krxLinkBtn').onclick = openKRXPage;

  // ─── 실시간 가격 조회 ───
  $('realtimeBtn').onclick = refreshRealtimePrice;
  $('banner').addEventListener('click', (e) => {
    const btn = e.target.closest('button[data-action]');
    if (!btn) return;
    if (btn.dataset.action === 'apply-realtime') applyRealtimeToData();
    else if (btn.dataset.action === 'dismiss-realtime') hideBanner();
  });

  // ─── 종목명 입력 즉시 종목코드 자동 인식 (IME composition 포함) ───
  $('symbol').addEventListener('input', autoFillSymbolCode);
  $('symbol').addEventListener('change', autoFillSymbolCode);
  $('symbol').addEventListener('compositionend', autoFillSymbolCode);
  $('symbol').addEventListener('blur', autoFillSymbolCode);

  // ─── 종목 코드 직접 입력 시: localStorage에 매핑 저장 ───
  $('symbolCode').addEventListener('input', markSymbolCodeManual);
  $('symbolCode').addEventListener('change', saveSymbolCodeAssoc);

  // ─── 최근 종목 드롭다운 ───
  $('symbol').addEventListener('focus', showRecentMenu);
  $('symbol').addEventListener('blur', hideRecentMenu);
  $('recentMenu').addEventListener('mousedown', (e) => {
    const item = e.target.closest('.recent-item');
    if (item && item.dataset.id) {
      e.preventDefault();
      hideRecentMenu();
      loadSavedAnalysis(item.dataset.id);
    }
  });

  // ─── CSV 미리보기 (기존 input 이벤트 강화) ───
  $('krxInput').addEventListener('input', updateCsvPreview);

  // ─── 사용자 가격선 ───
  $('up_addBtn').onclick = addUserPrice;
  $('up_list').addEventListener('click', (e) => {
    if (e.target.classList.contains('x-btn')) {
      removeUserPrice(e.target.dataset.id);
    }
  });

  // ─── 미니 바 버튼 ───
  $('miniRunBtn').onclick = () => runAnalysis();
  $('miniExpandBtn').onclick = expandStickyMini;
  setupStickyMini();

  // 저장 / 불러오기 모달
  $('savedBtn').onclick = openSavedModal;
  $('savedCloseBtn').onclick = closeSavedModal;
  $('saveCurrentBtn').onclick = saveCurrentAnalysis;
  $('savedModal').addEventListener('click', (e) => {
    if (e.target.id === 'savedModal') closeSavedModal();
  });
  $('savedList').addEventListener('click', (e) => {
    const btn = e.target.closest('button[data-action]');
    if (!btn) return;
    const id = btn.dataset.id;
    if (btn.dataset.action === 'load') loadSavedAnalysis(id);
    else if (btn.dataset.action === 'delete') deleteSaved(id);
    else if (btn.dataset.action === 'rename') renameSaved(id);
  });
  $('savedExportBtn').onclick = exportSavedJson;
  $('savedImportBtn').onclick = () => $('savedImportFile').click();
  $('savedImportFile').addEventListener('change', (e) => {
    if (e.target.files[0]) {
      importSavedJson(e.target.files[0]);
      e.target.value = '';
    }
  });

  // 공유 모달
  $('shareBtn').onclick = openShareModal;
  $('shareCloseBtn').onclick = closeShareModal;
  $('shareDownloadBtn').onclick = downloadShareCanvas;
  $('shareCopyBtn').onclick = copyShareCanvas;
  $('shareWebBtn').onclick = shareCanvasWeb;
  document.querySelectorAll('.share-option').forEach(btn => {
    btn.onclick = () => captureAndPreview(btn.dataset.target);
  });
  $('shareModal').addEventListener('click', (e) => {
    if (e.target.id === 'shareModal') closeShareModal();
  });
  // 종가 입력 후 Enter → 적용
  $('qe_close').addEventListener('keydown', (e) => {
    if (e.key === 'Enter') applyQuickEntry();
  });

  // 모달 백드롭 클릭으로 닫기
  $('dataModal').addEventListener('click', (e) => {
    if (e.target.id === 'dataModal') closeDataModal();
  });
  // ESC 키로 모달 닫기
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if ($('dataModal').classList.contains('show')) closeDataModal();
      if ($('quickModal').classList.contains('show')) closeQuickModal();
      if ($('shareModal').classList.contains('show')) closeShareModal();
      if ($('savedModal').classList.contains('show')) closeSavedModal();
      if ($('positionModal').classList.contains('show')) closePositionModal();
      if ($('settingsModal').classList.contains('show')) closeSettingsModal();
      if ($('watchlistModal').classList.contains('show')) closeWatchlistModal();
      if ($('compareModal').classList.contains('show')) closeCompareModal();
      if ($('tourOverlay').classList.contains('show')) closeTour();
    }
  });

  $('clearBtn').onclick = () => {
    $('krxInput').value = '';
    localStorage.removeItem(RAW_KEY);
    state.data = []; state.rawDaily = [];
    ['summaryCard', 'tradeCard', 'priceCard', 'signalCard', 'userPricesCard', 'indicatorCard', 'chartsArea', 'glossaryCard']
      .forEach(id => { const el = $(id); if (el) el.style.display = 'none'; });
    $('alertArea').innerHTML = '';
    $('staleArea').innerHTML = '';
    $('parseHint').textContent = '붙여넣은 후 자동으로 행 수가 표시됩니다.';
    updateDataStatus(0, 0);
    hideBanner();
    showToast('데이터를 지웠습니다.');
  };

  $('sampleBtn').onclick = () => {
    $('krxInput').value = makeSampleKRX();
    if (!$('symbol').value.trim()) $('symbol').value = '샘플종목';
    runAnalysis();
    showToast('샘플 KRX 데이터로 분석을 실행했습니다.');
  };

  document.querySelectorAll('#indicatorBar .btn').forEach(b => {
    b.onclick = () => {
      const k = b.dataset.ind;
      state.indicators[k] = !state.indicators[k];
      b.classList.toggle('active', state.indicators[k]);
      saveSettings();
      if (state.data.length > 0) renderCharts();
    };
  });

  ['symbol', 'startDate', 'endDate'].forEach(id => {
    $(id).addEventListener('change', saveSettings);
  });

  // 붙여넣기 후 행 수 즉시 표시
  $('krxInput').addEventListener('input', () => {
    const v = $('krxInput').value;
    if (!v.trim()) { $('parseHint').textContent = '붙여넣은 후 자동으로 행 수가 표시됩니다.'; return; }
    const lines = v.split(/\r?\n/).filter(l => l.trim()).length;
    $('parseHint').textContent = `${lines}줄 입력됨 (헤더 포함). [분석 시작] 버튼을 누르세요.`;
  });

  // 리사이즈 대응
  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      const map = { main: 'chartMain', volume: 'chartVolume', rsi: 'chartRSI', macd: 'chartMACD' };
      Object.entries(state.charts).forEach(([k, c]) => {
        const el = $(map[k]);
        if (el && c) c.applyOptions({ width: el.clientWidth, height: el.clientHeight });
      });
    }, 120);
  });
}

window.addEventListener('DOMContentLoaded', () => {
  loadUserOpts();
  loadSettings();
  bind();
  updateSavedBadge();
  updateWatchBadge();
  loadCollapsedState();
  // 부팅 시 종목명 기반 코드 자동 채우기
  autoFillSymbolCode();
  // 첫 방문이면 투어 자동 시작
  const tourDone = localStorage.getItem('krx_tour_done');
  if (!tourDone && !$('krxInput').value.trim()) {
    setTimeout(openTour, 500);
  } else if ($('krxInput').value.trim()) {
    setTimeout(() => runAnalysis({ silentEmpty: true }), 80);
  } else {
    setTimeout(openDataModal, 200);
  }
});
</script>
</body>
</html>
