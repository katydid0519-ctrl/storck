/* ============================================================
 *  CSV 헤더 실시간 인식 미리보기
 * ========================================================== */
function updateCsvPreview() {
  const text = $('krxInput').value;
  const hintEl = $('parseHint');
  if (!text.trim()) {
    hintEl.textContent = '붙여넣은 후 자동으로 행 수가 표시됩니다.';
    hintEl.className = 'hint';
    return;
  }
  try {
    const lines = text.split(/\r?\n/).filter(l => l.trim());
    const sep = detectSeparator(lines[0]);
    const headers = splitLine(lines[0], sep).map(h => h.trim().replace(/\s+/g, ''));
    const want = { '일자':false, '종가':false, '시가':false, '고가':false, '저가':false, '거래량':false };
    headers.forEach(h => {
      Object.keys(want).forEach(k => {
        if (h === k || h.toLowerCase() === { '일자':'date', '종가':'close', '시가':'open', '고가':'high', '저가':'low', '거래량':'volume' }[k]) want[k] = true;
      });
    });
    const required = ['일자', '종가', '시가', '고가', '저가'];
    const missing = required.filter(k => !want[k]);
    const okCount = Object.values(want).filter(Boolean).length;
    const dataLines = lines.length - 1;
    if (missing.length === 0) {
      hintEl.innerHTML = `✅ <b>${okCount}/6 컬럼 인식</b> · 데이터 <b>${dataLines}행</b> · 헤더: <b>${headers.slice(0, 7).join(', ')}</b>${headers.length > 7 ? '...' : ''}`;
      hintEl.className = 'hint';
      hintEl.style.color = 'var(--good)';
    } else {
      hintEl.innerHTML = `⚠️ <b>필수 컬럼 누락</b>: ${missing.join(', ')} · 감지된 헤더: ${headers.slice(0, 8).join(' | ')}`;
      hintEl.style.color = 'var(--warn)';
    }
  } catch (e) {
    hintEl.textContent = '입력 형식 확인 중...';
    hintEl.style.color = '';
  }
}

