 * ========================================================== */
function renderPriceAlerts() {
  const area = $('alertArea');
  area.innerHTML = '';
  if (!userOpts.alerts || !state.data.length || !state.levels) return;
  const cur = state.data[state.data.length - 1].close;
  const L = state.levels;
  const alerts = [];

  if (cur <= L.stopLoss * 1.01) {
    alerts.push({ type: 'danger', html: `🛑 <b>손절가 ${fmtNum(L.stopLoss, 0)} 도달/근접</b> — 현재가 ${fmtNum(cur, 0)}. 손실 관리가 필요한 구간입니다.` });
  }
  if (cur >= L.target2 * 0.995) {
    alerts.push({ type: 'good', html: `🚀 <b>2차 목표가 ${fmtNum(L.target2, 0)} 도달!</b> — 현재가 ${fmtNum(cur, 0)}. 익절을 고려하세요.` });
  } else if (cur >= L.target1 * 0.995) {
    alerts.push({ type: 'good', html: `🎯 <b>1차 목표가 ${fmtNum(L.target1, 0)} 도달!</b> — 현재가 ${fmtNum(cur, 0)}. 50% 익절 + 손절선 본전 상향을 고려하세요.` });
  }

  area.innerHTML = alerts.map(a => `<div class="alert-banner ${a.type}">${a.html}</div>`).join('');

  // 브라우저 알림 (권한 받았으면)
  if (alerts.length && 'Notification' in window && Notification.permission === 'granted') {
    const lastKey = 'krx_last_alert_' + (state.symbol || '_');
    const lastAlertKey = alerts.map(a => a.html).join('|');
    if (localStorage.getItem(lastKey) !== lastAlertKey) {
      localStorage.setItem(lastKey, lastAlertKey);
      try {
        new Notification(`${state.symbol || '종목'} 알림`, {
          body: alerts[0].html.replace(/<[^>]*>/g, ''),
          icon: '📊',
        });
      } catch (e) {}
    }
  }
}
