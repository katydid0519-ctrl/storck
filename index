function lookupCodeForSymbol(name) {
  if (!name) return '';
  const clean = name.trim();
  // 1. localStorage (사용자가 직접 등록한 매핑)
  try {
    const code = localStorage.getItem('krx_code_' + clean);
    if (code) return code;
  } catch (e) {}
  // 2. 내장 매핑 (정확 일치)
  if (KRX_CODE_MAP[clean]) return KRX_CODE_MAP[clean];
  // 3. 대소문자 무시 매칭
  const lower = clean.toLowerCase();
  for (const [k, v] of Object.entries(KRX_CODE_MAP)) {
    if (k.toLowerCase() === lower) return v;
  }
  return '';
}
