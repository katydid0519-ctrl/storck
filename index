function updateSavedSize() {
  try {
    const raw = localStorage.getItem(SAVED_LIST_KEY) || '';
    const bytes = new Blob([raw]).size;
    const kb = (bytes / 1024).toFixed(1);
    $('savedSize').textContent = `${kb} KB / 약 5,120 KB`;
  } catch (e) { $('savedSize').textContent = '-'; }
}

function exportSavedJson() {
  const list = loadSavedList();
  if (list.length === 0) { showToast('⚠️ 저장된 항목이 없습니다'); return; }
  const json = JSON.stringify({ version: 1, exportedAt: new Date().toISOString(), items: list }, null, 2);
  const blob = new Blob([json], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `krx_analysis_backup_${new Date().toISOString().slice(0,10)}.json`;
  document.body.appendChild(a); a.click();
  setTimeout(() => { document.body.removeChild(a); URL.revokeObjectURL(url); }, 100);
  showToast(`📤 ${list.length}건을 내보냈습니다`);
}

function importSavedJson(file) {
  const reader = new FileReader();
  reader.onload = e => {
    try {
      const obj = JSON.parse(e.target.result);
      if (!obj.items || !Array.isArray(obj.items)) throw new Error('형식이 올바르지 않습니다');
      const current = loadSavedList();
      const existingIds = new Set(current.map(it => it.id));
      const merged = [...current];
      let added = 0;
      for (const it of obj.items) {
        if (!it.id || existingIds.has(it.id)) continue;
        merged.unshift(it);
        added++;
      }
      while (merged.length > SAVED_MAX) merged.pop();
      if (writeSavedList(merged)) {
        renderSavedList();
        updateSavedBadge();
        updateSavedSize();
        showToast(`📥 ${added}건을 가져왔습니다 (총 ${merged.length}건)`);
      }
    } catch (err) {
      showToast('❌ 가져오기 실패: ' + err.message);
    }
  };
  reader.readAsText(file);
}

/* ============================================================
 *  빠른 입력 적용 (오늘 한 줄을 KRX 텍스트에 병합)
 * ========================================================== */
function applyQuickEntry() {
  const date = $('qe_date').value;
  const close = parseFloat($('qe_close').value);
  if (!date || isNaN(close) || close <= 0) {
    showBanner('일자와 종가는 필수입니다. 종가에 숫자를 입력해주세요.', 'warn');
    return;
  }
  const open = parseFloat($('qe_open').value) || close;
  const high = parseFloat($('qe_high').value) || Math.max(open, close);
  const low = parseFloat($('qe_low').value) || Math.min(open, close);
  const volume = parseFloat($('qe_volume').value) || 0;

  // 검증
  if (high < Math.max(open, close) - 0.01 || low > Math.min(open, close) + 0.01) {
    showBanner('고가는 시가·종가의 최대값 이상, 저가는 최소값 이하여야 합니다.', 'warn');
    return;
  }

  // 기존 텍스트에 행 추가/교체
  const text = $('krxInput').value;
  const lines = text.split(/\r?\n/).filter(l => l.length > 0);
  if (lines.length === 0) { showBanner('기존 데이터가 없습니다.', 'warn'); return; }

  const header = lines[0];
  const sep = header.includes('\t') ? '\t' : ',';
  const headers = header.split(sep);

  // 이전 종가 (대비/등락률 계산용) — 가장 최근 행의 종가
  let prevClose = null;
  for (let i = 1; i < lines.length; i++) {
    const c = lines[i].split(sep);
    if (c.length < 2) continue;
    const ld = normalizeDate(c[0]);
    if (!/^\d{4}-\d{2}-\d{2}$/.test(ld)) continue;
    if (ld === date) continue;
    const closeIdx = headers.findIndex(h => h.trim() === '종가' || h.trim().toLowerCase() === 'close');
    if (closeIdx >= 0) {
      prevClose = cleanNum(c[closeIdx]);
      if (!isNaN(prevClose)) break;
    }
  }

  const fmt = n => Math.round(n).toLocaleString('en-US');
  const diff = prevClose != null ? close - prevClose : null;
  const diffPct = (prevClose && prevClose !== 0) ? (diff / prevClose * 100) : null;

  const newRow = headers.map(h => {
    const k = h.trim().replace(/\s+/g, '');
    if (k === '일자' || k.toLowerCase() === 'date') return date.replace(/-/g, '/');
    if (k === '종가' || k.toLowerCase() === 'close') return fmt(close);
    if (k === '시가' || k.toLowerCase() === 'open') return fmt(open);
    if (k === '고가' || k.toLowerCase() === 'high') return fmt(high);
    if (k === '저가' || k.toLowerCase() === 'low') return fmt(low);
    if (k === '거래량' || k.toLowerCase() === 'volume') return fmt(volume);
    if (k === '대비') return diff != null ? (diff >= 0 ? '▲' : '▼') + fmt(Math.abs(diff)) : '';
    if (k === '등락률(%)' || k === '등락률' || k === '등락') return diffPct != null ? (diffPct >= 0 ? '+' : '') + diffPct.toFixed(2) : '';
    return '';
  }).join(sep);

  // 같은 날짜가 있으면 교체, 없으면 헤더 다음에 삽입(KRX는 보통 최신이 위)
  let replaced = false;
  for (let i = 1; i < lines.length; i++) {
    const c = lines[i].split(sep);
    if (c.length < 2) continue;
    const ld = normalizeDate(c[0]);
    if (ld === date) {
      lines[i] = newRow;
      replaced = true;
      break;
    }
  }
  if (!replaced) lines.splice(1, 0, newRow);

  $('krxInput').value = lines.join('\n');

  // 입력 필드 초기화
  $('qe_open').value = '';
  $('qe_high').value = '';
  $('qe_low').value = '';
  $('qe_volume').value = '';

  closeQuickModal();
  runAnalysis();
  showToast(replaced ? `${date} 데이터를 갱신했습니다.` : `${date} 데이터를 추가했습니다.`);
}

/* ============================================================
 *  시나리오 분석 (오늘 ±5%/±10%일 때 매매 레벨 변화)
 * ========================================================== */
function addBusinessDays(dateStr, days) {
  const d = new Date(dateStr);
  let added = 0;
  while (added < days) {
    d.setDate(d.getDate() + 1);
    const dow = d.getDay();
    if (dow !== 0 && dow !== 6) added++;
  }
  return d.toISOString().slice(0, 10);
}
function calcScenario(data, pctChange) {
  const last = data[data.length - 1];
  if (pctChange === 0) {
    return {
      pctChange: 0,
      newClose: last.close,
      levels: state.levels || calcTradingLevels(data),
      score: state.scoreObj || calcScore(data),
    };
  }
  const newClose = last.close * (1 + pctChange / 100);
  const newBar = {
    time: addBusinessDays(last.time, 1),
    open: last.close,
    high: Math.max(last.close, newClose),
    low: Math.min(last.close, newClose),
    close: newClose,
    volume: data.length >= 20 ? avg(data.slice(-20).map(d => d.volume)) : (last.volume || 0),
  };
  const newData = [...data, newBar];
  return {
    pctChange,
    newClose,
    levels: calcTradingLevels(newData),
    score: calcScore(newData),
  };
}
function scenarioOpinion(score) {
  if (score >= 70) return { label: '🟢 매수관심', color: 'var(--good)', bg: 'rgba(16,185,129,0.15)' };
  if (score >= 55) return { label: '🟢 약매수',   color: '#84cc16',     bg: 'rgba(132,204,22,0.15)' };
  if (score >= 45) return { label: '🟡 관망',     color: 'var(--warn)', bg: 'rgba(245,158,11,0.15)' };
  if (score >= 35) return { label: '🟠 약매도',   color: '#f97316',     bg: 'rgba(249,115,22,0.15)' };
  return                  { label: '🔴 매도검토', color: 'var(--bad)',  bg: 'rgba(239,68,68,0.15)' };
}
function scenarioNote(pct, sc) {
  if (pct === 0) return '현재 상태';
  const rr = sc.levels ? sc.levels.rr1 : 0;
  if (pct <= -10) {
    return rr >= 2 ? '큰 조정 → 분할매수 기회 (손익비 ↑)' : '추가 하락 위험, 손절 라인 점검';
  }
  if (pct <= -5) {
    return rr >= 2 ? '조정 매수 관심 구간' : '추세 약화 가능성, 신중히';
  }
  if (pct >= 10) {
    return '🔥 급등, 추격 매수 주의 / 보유자는 일부 익절';
  }
  if (pct >= 5) {
    return rr >= 1.5 ? '추세 강화, 1차 목표 도달 가능' : '단기 과열, 추격은 손절선 짧게';
  }
  return '';
}
/* ============================================================
 *  내 포지션 손익 분석
 * ========================================================== */
function getPositionKey() {
  return 'krx_pos_' + (state.symbol || 'default');
}
function loadPosition() {
  try {
    const p = JSON.parse(localStorage.getItem(getPositionKey()) || 'null');
    if (p && p.avgPrice && p.quantity) {
      $('pos_avgPrice').value = p.avgPrice;
      $('pos_quantity').value = p.quantity;
    } else {
      $('pos_avgPrice').value = '';
      $('pos_quantity').value = '';
    }
  } catch (e) { /* ignore */ }
}
function savePosition() {
  const avgPrice = parseFloat($('pos_avgPrice').value);
  const quantity = parseFloat($('pos_quantity').value);
  if (avgPrice > 0 && quantity > 0) {
    localStorage.setItem(getPositionKey(), JSON.stringify({ avgPrice, quantity }));
  }
}
function clearPosition() {
  $('pos_avgPrice').value = '';
  $('pos_quantity').value = '';
  localStorage.removeItem(getPositionKey());
  renderPositionSection();
}

function positionAdvice(plPct, L) {
  const stopStr = L ? fmtNum(L.stopLoss, 0) : '-';
  if (plPct >= 30) return { type: 'good', html: `🎉 <b>+${plPct.toFixed(1)}% 큰 수익 중!</b> 욕심을 경계하세요. <b>50% 익절 + 손절선을 본전 위로 끌어올려</b> 수익을 보호하는 전략을 추천합니다.` };
  if (plPct >= 15) return { type: 'good', html: `✨ <b>+${plPct.toFixed(1)}% 수익 중</b>. 1차 목표가에 근접한 상태입니다. 일부 익절을 시작하고 손절선을 본전(${fmtNum(parseFloat($('pos_avgPrice').value), 0)})으로 상향 조정하세요.` };
  if (plPct >= 5)  return { type: 'good', html: `🙂 <b>+${plPct.toFixed(1)}% 수익 중</b>. 추세가 살아있다면 보유를 지속하되, <b>손절가 ${stopStr}</b>까지 빠질 경우의 손실 규모를 미리 확인해두세요.` };
  if (plPct >= -3) return { type: 'warn', html: `😐 <b>${fmtPct(plPct)} (본전 부근)</b>. 평가손익이 미미합니다. 추세 방향이 명확해질 때까지 손절선·목표선을 명확히 정해두고 대응하세요.` };
  if (plPct >= -10) return { type: 'warn', html: `⚠️ <b>${fmtPct(plPct)} 손실 중</b>. 손절가(${stopStr})까지 여유가 있다면 보유, 가까워졌다면 추세 점검 후 결단하세요. 추가 매수는 종합 점수가 50점 이상일 때만 신중히.` };
  if (plPct >= -20) return { type: 'danger', html: `🚨 <b>${fmtPct(plPct)} 큰 손실 중</b>. 추세가 명확히 하락 중이면 손절, 바닥 신호가 보이면 분할 매수로 평단 낮추기를 고려하세요. <b>"물타기 함정"</b>을 주의 — 떨어진다고 무조건 사면 손실이 눈덩이가 됩니다.` };
  return { type: 'danger', html: `💀 <b>${fmtPct(plPct)} 심각한 손실</b>. 감정적 매도/물타기는 금물입니다. 펀더멘털(실적·재무)을 재점검하고, 추세 반전 신호가 명확히 나올 때까지 차분히 기다리세요.` };
}

function renderPositionSection() {
  if (!state.data.length) return;

  const tab = state.positionTab || 'summary';

  // 시장 시나리오 분석은 매수 정보 없이도 볼 수 있음
  if (tab === 'market') {
    $('positionResult').innerHTML = renderPosMarketScenario();
    return;
  }

  const avgPrice = parseFloat($('pos_avgPrice').value);
  const qty = parseFloat($('pos_quantity').value);

  if (isNaN(avgPrice) || isNaN(qty) || avgPrice <= 0 || qty <= 0) {
    $('positionResult').innerHTML = `
      <div class="pos-empty">
        ⬆️ 이 메뉴는 <b>평균 매수가</b>와 <b>보유 수량</b> 입력이 필요합니다.
        <br><br>매수 정보 없이도 볼 수 있는 <b>⚡ 시장 시나리오 분석</b> 탭을 선택해보세요.
      </div>
    `;
    return;
  }

  savePosition();

  const current = state.data[state.data.length - 1].close;
  const ctx = { avgPrice, qty, current, L: state.levels };

  if (tab === 'summary')        $('positionResult').innerHTML = renderPosSummary(ctx);
  else if (tab === 'scenarios') $('positionResult').innerHTML = renderPosScenarios(ctx);
  else if (tab === 'addbuy')    $('positionResult').innerHTML = renderPosAddBuy(ctx);
}

/* --- 탭 4: 시장 시나리오 분석 (매매 레벨 변화) --- */
function renderPosMarketScenario() {
  const data = state.data;
  if (data.length < 20) {
    return '<div class="pos-empty">시장 시나리오 분석에는 최소 20개 봉이 필요합니다. 더 긴 기간의 데이터를 입력해주세요.</div>';
  }
  const pcts = [-10, -5, 0, 5, 10];
  const rows = pcts.map(p => calcScenario(data, p));

  const head = `
    <thead>
      <tr>
        <th>시나리오</th>
        <th>가상 종가</th>
        <th>종합점수</th>
        <th>의견</th>
        <th>1차 매수가</th>
        <th>손절가</th>
        <th>1차 목표</th>
        <th>손익비</th>
        <th class="note">참고</th>
      </tr>
    </thead>`;
  const body = `
    <tbody>
      ${rows.map(r => {
        const op = scenarioOpinion(r.score.total);
        const rowClass = r.pctChange === 0 ? 'current' : (r.pctChange < 0 ? 'down' : 'up');
        const L = r.levels;
        return `
          <tr class="${rowClass}">
            <td>${r.pctChange === 0 ? '현재가' : (r.pctChange > 0 ? '+' : '') + r.pctChange + '%'}</td>
            <td>${fmtNum(r.newClose, 0)}</td>
            <td><b>${r.score.total}</b></td>
            <td><span class="scenario-pill" style="background:${op.bg}; color:${op.color}">${op.label}</span></td>
            <td>${L ? fmtNum(L.splitBuy[0].price, 0) : '-'}</td>
            <td style="color:var(--bad)">${L ? fmtNum(L.stopLoss, 0) : '-'}</td>
            <td style="color:var(--good)">${L ? fmtNum(L.target1, 0) : '-'}</td>
            <td><b>${L ? L.rr1.toFixed(2) : '-'}</b></td>
            <td class="note">${escapeHtml(scenarioNote(r.pctChange, r))}</td>
          </tr>
        `;
      }).join('')}
    </tbody>`;

  return `
    <div class="pos-section-title">⚡ 시장 시나리오 분석 <span style="font-size:11px;color:var(--muted);font-weight:400;">(오늘 ±5%/±10% 시 레벨 변화)</span></div>
    <div class="tip" style="margin-bottom:10px;">
      💡 <b>"만약 오늘 이 가격으로 마감한다면?"</b> 시장 분석 결과인 매수가·손절가·목표가·손익비·종합점수가 어떻게 바뀔지 미리보기.
      급등/급락 대응 시뮬레이션에 활용하세요. <b>매수 정보 입력 불필요</b>합니다.
    </div>
    <div class="scroll-x">
      <table class="scenario-table">${head}${body}</table>
