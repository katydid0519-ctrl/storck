const COLLAPSED_KEY = 'krx_collapsed_v1';
const COLLAPSIBLE_IDS = ['summaryCard', 'tradeCard', 'priceCard', 'signalCard', 'userPricesCard', 'indicatorCard'];

// 전체 접기/펼치기 토글
function toggleAllCollapsibles() {
  // 표시 중인 카드만 대상으로 함
  const visible = COLLAPSIBLE_IDS.map(id => $(id)).filter(c => c && c.style.display !== 'none');
  if (visible.length === 0) {
    showToast('먼저 분석을 실행해주세요');
    return;
  }
  // 하나라도 펼쳐져 있으면 모두 접기, 모두 접혀 있으면 모두 펼치기
  const anyExpanded = visible.some(c => !c.classList.contains('collapsed'));
  visible.forEach(c => {
    if (anyExpanded) c.classList.add('collapsed');
    else c.classList.remove('collapsed');
  });
  saveCollapsedState();
  updateCollapseAllBtn();
  showToast(anyExpanded ? '📁 모든 카드를 접었습니다' : '📂 모든 카드를 펼쳤습니다');
}
function updateCollapseAllBtn() {
  const btn = $('collapseAllBtn');
  if (!btn) return;
  const visible = COLLAPSIBLE_IDS.map(id => $(id)).filter(c => c && c.style.display !== 'none');
  const anyExpanded = visible.some(c => !c.classList.contains('collapsed'));
  btn.textContent = anyExpanded ? '📁 모두 접기' : '📂 모두 펼치기';
}

function saveCollapsedState() {
  const obj = {};
  COLLAPSIBLE_IDS.forEach(id => {
    const card = $(id);
    if (card) obj[id] = card.classList.contains('collapsed');
  });
  try { localStorage.setItem(COLLAPSED_KEY, JSON.stringify(obj)); } catch (e) {}
}
function loadCollapsedState() {
  try {
    const obj = JSON.parse(localStorage.getItem(COLLAPSED_KEY) || '{}');
    COLLAPSIBLE_IDS.forEach(id => {
      const card = $(id);
      if (!card) return;
      if (obj[id]) card.classList.add('collapsed');
      else card.classList.remove('collapsed');
    });
  } catch (e) {}
}
