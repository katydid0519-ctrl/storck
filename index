// 포커스가 살아있는 동안 클립보드에 즉시 쓰기
// execCommand는 동기 실행이라 window.open 이전 호출이 확실히 동작
function copyToClipboardSafe(text) {
  if (!text) return false;
  // 1차: execCommand (동기, 거의 모든 브라우저 지원)
  try {
    const ta = document.createElement('textarea');
    ta.value = String(text);
    ta.setAttribute('readonly', '');
    ta.style.cssText = 'position:fixed; left:-9999px; top:0; opacity:0; pointer-events:none;';
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    ta.setSelectionRange(0, ta.value.length);
    const ok = document.execCommand('copy');
    document.body.removeChild(ta);
    if (ok) return true;
  } catch (e) {}
  // 2차: 모던 비동기 API (시도만 — 실패해도 무시)
  try {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(String(text)).catch(() => {});
      return true;
    }
  } catch (e) {}
  return false;
}

/* ============================================================
 *  실시간 가격 가져오기 (Stooq + Yahoo Finance, 15~20분 지연)
 * ========================================================== */
async function fetchRealtimeFromStooq(code) {
  // Stooq: 한국 종목은 .ks(코스피)/.kq(코스닥)/.kr(범용) 접미사 사용
  for (const suffix of ['.ks', '.kq', '.kr']) {
    try {
      const url = `https://stooq.com/q/l/?s=${encodeURIComponent(code + suffix)}&f=sd2t2ohlcv&h&e=csv`;
      const res = await fetch(url, { mode: 'cors' });
      if (!res.ok) continue;
      const text = await res.text();
      const lines = text.trim().split(/\r?\n/);
      if (lines.length < 2) continue;
      const headers = lines[0].split(',').map(h => h.trim());
      const values = lines[1].split(',').map(v => v.trim());
      const m = {};
      headers.forEach((h, i) => m[h] = values[i]);
      const close = parseFloat(m.Close);
      if (!close || isNaN(close) || close <= 0) continue;
      return {
        source: 'Stooq',
        symbol: code + suffix,
        price: close,
        open: parseFloat(m.Open) || null,
        high: parseFloat(m.High) || null,
        low: parseFloat(m.Low) || null,
        volume: parseFloat(m.Volume) || null,
        date: m.Date,
        time: m.Time,
      };
    } catch (e) { /* try next suffix */ }
  }
  return null;
}
async function fetchRealtimeFromYahoo(code) {
  // Yahoo Finance: .KS(코스피)/.KQ(코스닥) 접미사
  for (const suffix of ['.KS', '.KQ']) {
    try {
      const url = `https://query1.finance.yahoo.com/v8/finance/chart/${encodeURIComponent(code + suffix)}?interval=1d&range=2d`;
      const res = await fetch(url, { mode: 'cors' });
      if (!res.ok) continue;
      const json = await res.json();
      const result = json?.chart?.result?.[0];
      const meta = result?.meta;
      if (!meta?.regularMarketPrice) continue;
      const quote = result?.indicators?.quote?.[0] || {};
      const idx = (quote.close?.length || 1) - 1;
      return {
        source: 'Yahoo Finance',
        symbol: code + suffix,
        price: meta.regularMarketPrice,
        prevClose: meta.previousClose || meta.chartPreviousClose,
        open: quote.open?.[idx] ?? null,
        high: quote.high?.[idx] ?? null,
        low: quote.low?.[idx] ?? null,
        volume: quote.volume?.[idx] ?? null,
        time: meta.regularMarketTime ? new Date(meta.regularMarketTime * 1000) : null,
      };
    } catch (e) { /* try next */ }
  }
  return null;
}
async function fetchRealtimePrice(code) {
  // 1차 Stooq 시도 → 2차 Yahoo 시도
  let r = await fetchRealtimeFromStooq(code);
  if (r) return r;
  r = await fetchRealtimeFromYahoo(code);
  if (r) return r;
  throw new Error('두 가지 무료 API(Stooq · Yahoo Finance) 모두 실패했습니다. CORS 차단 또는 일시적 다운일 수 있습니다.');
}

