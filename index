    <div class="position-stats">
      <div class="pos-stat">
        <div class="pos-lbl">💵 매수 총액</div>
        <div class="pos-val">${fmtNum(cost, 0)}원</div>
        <div class="pos-sub">${fmtNum(avgPrice, 0)} × ${fmtInt(qty)}주</div>
      </div>
      <div class="pos-stat">
        <div class="pos-lbl">💎 현재 평가액</div>
        <div class="pos-val">${fmtNum(value, 0)}원</div>
        <div class="pos-sub">현재가 ${fmtNum(current, 0)}</div>
      </div>
      <div class="pos-stat ${plClass}">
        <div class="pos-lbl">📊 평가 손익</div>
        <div class="pos-val ${plColor}">${pl >= 0 ? '+' : ''}${fmtNum(pl, 0)}원</div>
        <div class="pos-sub ${plColor}"><b>${fmtPct(plPct)}</b></div>
      </div>
      <div class="pos-stat warn">
        <div class="pos-lbl">📍 손익분기점 (BEP)</div>
        <div class="pos-val">${fmtNum(avgPrice, 0)}원</div>
        <div class="pos-sub">현재가 ${current >= avgPrice ? '+' : ''}${((current - avgPrice) / avgPrice * 100).toFixed(2)}% ${current >= avgPrice ? '위' : '아래'}</div>
      </div>
      ${L ? `
        <div class="pos-stat loss">
