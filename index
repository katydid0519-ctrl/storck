  const rawText = $('krxInput').value;
  const avgPrice = parseFloat($('pos_avgPrice').value) || null;
  const quantity = parseFloat($('pos_quantity').value) || null;

  const last = state.data[state.data.length - 1];
  const prev = state.data[state.data.length - 2] || last;
  const dayChgPct = prev.close ? ((last.close - prev.close) / prev.close * 100) : 0;

  const item = {
    id: 'snap_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7),
    title,
    symbol: state.symbol || '종목',
    interval: state.interval,
    start: $('startDate').value,
    end: $('endDate').value,
    rawText,
    position: (avgPrice > 0 && quantity > 0) ? { avgPrice, quantity } : null,
    indicators: { ...state.indicators },
    savedAt: new Date().toISOString(),
    cache: {
      barCount: state.data.length,
      lastDate: last.time,
      lastPrice: last.close,
      dayChgPct,
      score: state.scoreObj?.total ?? null,
      levels: state.levels ? {
        buy1: state.levels.splitBuy[0].price,
        buy2: state.levels.splitBuy[1].price,
        buy3: state.levels.splitBuy[2].price,
        avgBuy: state.levels.avgBuy,
        stopLoss: state.levels.stopLoss,
        target1: state.levels.target1,
        target2: state.levels.target2,
        rr1: state.levels.rr1,
        high52w: state.levels.high52w,
        low52w: state.levels.low52w,
      } : null,
    },
  };

  const list = loadSavedList();
  list.unshift(item);
  while (list.length > SAVED_MAX) list.pop();

  if (writeSavedList(list)) {
    $('saveTitle').value = '';
    renderSavedList();
    updateSavedBadge();
    updateWatchBadge();
    updateSavedSize();
    showToast(`💾 저장 완료 (총 ${list.length}건)`);
