  `;
}

/* --- 탭 2: 가격별 손익 시나리오 (평단 기준) --- */
function renderPosScenarios(ctx) {
  const { avgPrice, qty, current, L } = ctx;
  const cost = avgPrice * qty;

  // 평균 매수가 기준 변동 (사용자 매수가 기준)
  const scenarios = [];
  const pctOffsets = [-30, -20, -15, -10, -5, 0, 5, 10, 15, 20, 30, 50];
  pctOffsets.forEach(p => {
    const label = p === 0 ? '평단 (BEP)' : `평단 ${p > 0 ? '+' : ''}${p}%`;
    scenarios.push({ label, price: avgPrice * (1 + p / 100), bep: p === 0 });
  });

  // 주요 가격 landmark (참고용)
  scenarios.push({ label: '📍 현재가', price: current, highlight: true });
  if (L) {
    scenarios.push({ label: '🛑 손절가', price: L.stopLoss });
    scenarios.push({ label: '🎯 1차 목표', price: L.target1 });
    scenarios.push({ label: '🚀 2차 목표', price: L.target2 });
  }

  scenarios.sort((a, b) => a.price - b.price);
  const dedup = [];
  for (const s of scenarios) {
    const same = dedup.find(d => Math.abs(d.price - s.price) < 0.5);
    if (same) {
      if (s.highlight) same.highlight = true;
      if (s.bep) same.bep = true;
      same.label += ' / ' + s.label;
    } else dedup.push({ ...s });
  }

  const rows = dedup.map(s => {
    const v = s.price * qty;
    const sPl = v - cost;
    const sPlPct = (s.price - avgPrice) / avgPrice * 100;
    const fromCurrent = (s.price - current) / current * 100;
    const cls = sPl >= 0 ? 'pos' : 'neg';
    const fcCls = fromCurrent >= 0 ? 'pos' : 'neg';
    return `
      <tr class="${s.highlight ? 'current' : ''}">
        <td style="text-align:left;">${escapeHtml(s.label)}</td>
        <td>${fmtNum(s.price, 0)}</td>
        <td class="${fcCls}" style="font-size:11px;">${fmtPct(fromCurrent)}</td>
        <td>${fmtNum(v, 0)}</td>
        <td class="${cls}">${sPl >= 0 ? '+' : ''}${fmtNum(sPl, 0)}</td>
        <td class="${cls}"><b>${fmtPct(sPlPct)}</b></td>
      </tr>
    `;
  }).join('');

  return `
    <div class="pos-section-title">📈 가격별 손익 시나리오 <span style="font-size:11px;color:var(--muted);font-weight:400;">(평균 매수가 기준)</span></div>
    <div class="hint" style="margin-bottom:8px;">
      <b>평단 ${fmtNum(avgPrice, 0)}원</b> · 보유 <b>${fmtInt(qty)}주</b> · 현재가 <b>${fmtNum(current, 0)}원</b> · 매수총액 <b>${fmtNum(cost, 0)}원</b>
    </div>
    <div class="scroll-x">
      <table class="scenario-table">
        <thead>
          <tr>
            <th>시나리오</th>
            <th>가격</th>
            <th>현재가 대비</th>
            <th>평가액</th>
            <th>손익액</th>
            <th>수익률<br><span style="font-size:10px;font-weight:400;">(평단 대비)</span></th>
          </tr>
        </thead>
        <tbody>${rows}</tbody>
      </table>
    </div>
    <div class="hint" style="margin-top:8px;">
      ※ 모든 시나리오는 사용자가 입력한 <b>평균 매수가 ${fmtNum(avgPrice, 0)}원 기준</b>으로 ±%를 적용합니다.
      손절가·목표가는 매매 가이드 카드의 기술적 계산값.
    </div>
  `;
}

/* --- 탭 3: 추가 매수 시뮬레이션 --- */
function renderPosAddBuy(ctx) {
