        </div>
        <div class="pos-stat profit">
          <div class="pos-lbl">🚀 2차 목표가 도달 시</div>
          <div class="pos-val pos">+${fmtNum(gainOnT2, 0)}원</div>
          <div class="pos-sub pos">목표가 ${fmtNum(L.target2, 0)} (+${((L.target2 - avgPrice) / avgPrice * 100).toFixed(2)}%)</div>
        </div>
      ` : ''}
