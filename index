function renderSummary() {
  ['summaryCard', 'tradeCard', 'priceCard', 'signalCard', 'userPricesCard', 'indicatorCard', 'chartsArea', 'glossaryCard']
    .forEach(id => $(id).style.display = '');
  renderStaleWarning();
  renderUserPricesList();
  updateCollapseAllBtn();

  const data = state.data;
  if (data.length < 2) {
    $('summaryGrid').innerHTML = '<div class="stat"><div class="lbl">데이터</div><div class="val">데이터가 부족합니다</div></div>';
    return;
  }

  state.levels = calcTradingLevels(data);
  state.scoreObj = calcScore(data);
  const signals = detectSignals(data);
  state.signals = signals;
  const verdict = generateVerdict(data, signals, state.scoreObj);

  renderScoreSection(state.scoreObj, verdict);
  renderStatsSection(data);
  renderPriceRangeSection(state.levels);
  renderSignalsSection(signals);
  renderTradeSection(state.levels, verdict);
  loadPosition();
  renderPositionSection();
  renderPriceAlerts();
}

function renderScoreSection(scoreObj, verdict) {
  const total = scoreObj.total;
  const color = total >= 70 ? '#10b981' : total >= 55 ? '#3b82f6' : total >= 40 ? '#eab308' : '#ef4444';
  $('scoreMain').style.setProperty('--score-val', total);
  $('scoreMain').style.setProperty('--score-color', color);
  $('scoreMain').innerHTML = `
    <div class="score-circle" style="--score-val:${total}; --score-color:${color}">
      <div class="score-num" style="color:${color}">${total}</div>
      <div class="score-lbl">/ 100</div>
    </div>
    <div class="score-detail">
      <h3 style="color:${color}">${verdict.vEmoji} ${verdict.verdict}</h3>
      <div class="score-sub">기술적 종합 점수 — 추세·모멘텀·안정성·거래량을 합산</div>
      <div style="margin-top:8px; font-size:13px; line-height:1.6;">${escapeHtml(verdict.vDesc)}</div>
    </div>
  `;

  $('scoreBreakdown').innerHTML = scoreObj.breakdown.map(b => {
    const pct = (b.score / b.max) * 100;
    return `
      <div class="score-item">
        <div class="name"><b>${b.name}</b> <span>${b.score.toFixed(0)} / ${b.max}</span></div>
        <div class="score-bar"><div style="width:${pct}%; background:${b.color};"></div></div>
        <div class="desc">${escapeHtml(b.desc)}</div>
      </div>
    `;
  }).join('');

  $('verdictBox').innerHTML = `
    <div class="v-title" style="color:${verdict.vColor}">${verdict.vEmoji} ${verdict.verdict}</div>
    <div class="verdict-desc">${escapeHtml(verdict.vDesc)}</div>
    <ul>${verdict.reasons.map(r => `<li>${escapeHtml(r)}</li>`).join('')}</ul>
  `;

  // 부가 팁 박스
  const tips = [];
  if (scoreObj.volPct > 5) tips.push({
    type: 'warn',
    html: '<b>변동성 큰 종목</b>입니다. 분할 매수와 손절선 설정이 특히 중요합니다. 한 번에 전액 매수는 피하세요.'
  });
  if (scoreObj.trendSlopePct < -3) tips.push({
    type: 'danger',
    html: '<b>하락 추세 진행 중</b>입니다. 떨어진다고 무작정 사는 "물타기"는 위험합니다. 추세 전환 신호를 먼저 확인하세요.'
  });
  if (scoreObj.trendSlopePct > 5) tips.push({
    type: 'good',
    html: '<b>강한 상승 추세</b>입니다. 추격 매수보다는 단기 조정 시 분할 매수가 유리합니다.'
  });
  const rsiArr = calcRSI(state.data, 14);
  if (rsiArr.length && rsiArr[rsiArr.length - 1].value > 75) tips.push({
    type: 'warn',
    html: '<b>RSI 75 초과</b> — 과열 구간입니다. 신규 진입 시 손절선을 짧게 잡으세요.'
  });
  $('tipBox').innerHTML = tips.map(t => `<div class="tip ${t.type}">${t.html}</div>`).join('');
}

function renderStatsSection(data) {
  const last = data[data.length - 1];
  const prev = data[data.length - 2];
  const first = data[0];
  const dayChg = last.close - prev.close;
  const dayChgPct = dayChg / prev.close * 100;
  const periodChgPct = (last.close - first.close) / first.close * 100;

  let volPct = null;
  if (data.length >= 20) {
    const last20 = data.slice(-20).map(d => d.close);
    const m = avg(last20);
    const std = Math.sqrt(last20.reduce((s, v) => s + (v - m) ** 2, 0) / last20.length);
    volPct = std / m * 100;
  }
  const atr = calcATR(data, 14);
  const lastATR = atr.length ? atr[atr.length - 1].value : null;
  const chgClass = dayChg >= 0 ? 'pos' : 'neg';
  const perClass = periodChgPct >= 0 ? 'pos' : 'neg';

  $('summaryGrid').innerHTML = `
    <div class="stat">
      <div class="lbl">종목</div>
      <div class="val">${escapeHtml(state.symbol || '-')}</div>
      <div class="sub">${data.length}개 ${intervalLabel()}</div>
    </div>
    <div class="stat">
      <div class="lbl">현재가 (${last.time})</div>
      <div class="val">${fmtNum(last.close, 0)}</div>
      <div class="sub ${chgClass} ${dayChg >= 0 ? 'arrow-up' : 'arrow-down'}">${fmtNum(Math.abs(dayChg), 0)} (${fmtPct(dayChgPct)})</div>
    </div>
    <div class="stat">
      <div class="lbl">기간 수익률</div>
      <div class="val ${perClass} ${periodChgPct >= 0 ? 'arrow-up' : 'arrow-down'}">${fmtPct(periodChgPct)}</div>
      <div class="sub">${first.time} → ${last.time}</div>
    </div>
    <div class="stat">
      <div class="lbl">추세 판정</div>
      <div class="val">${trendName(data)}</div>
      <div class="sub">MA20·MA60 기울기 기반</div>
    </div>
    <div class="stat">
      <div class="lbl">20일 변동성</div>
      <div class="val">${volPct != null ? volPct.toFixed(2) + '%' : '-'}</div>
      <div class="sub">하루 평균 ATR: ${lastATR != null ? fmtNum(lastATR, 0) : '-'}</div>
    </div>
    <div class="stat">
      <div class="lbl">거래량 (5일 / 20일)</div>
      <div class="val">${volRatioText(data)}</div>
      <div class="sub">${volRatioText(data).startsWith('1.5') || parseFloat(volRatioText(data)) > 1.5 ? '관심 급증' : '평이'}</div>
    </div>
  `;
}

function renderPriceRangeSection(levels) {
  if (!levels) return;
  $('posMarker').style.left = `${Math.max(0, Math.min(100, levels.pos52w))}%`;
  $('low52Text').textContent = `52주 최저 ${fmtNum(levels.low52w, 0)}`;
  $('high52Text').textContent = `52주 최고 ${fmtNum(levels.high52w, 0)}`;
  $('posPctText').textContent = `현재 ${levels.pos52w.toFixed(1)}% 위치 (현재가 ${fmtNum(levels.current, 0)})`;

  let posTip;
  if (levels.pos52w > 85) {
    posTip = { type: 'warn', html: '<b>52주 신고가 부근</b>입니다. 강한 추세를 의미할 수 있지만, 추격 매수는 손절선을 짧게 잡고 진입하세요.' };
  } else if (levels.pos52w > 60) {
    posTip = { type: 'good', html: '<b>상위권 가격대</b>에 있습니다. 추세가 살아있을 가능성이 큽니다.' };
  } else if (levels.pos52w < 15) {
    posTip = { type: 'warn', html: '<b>52주 신저가 부근</b>입니다. 바닥 매수 기회일 수도 있지만, 추세 하락 중이라면 추가 하락 위험도 있습니다.' };
  } else if (levels.pos52w < 40) {
    posTip = { type: '', html: '<b>하위권 가격대</b>입니다. 박스권 하단일 수 있으니 추세 전환 신호를 확인하세요.' };
  } else {
    posTip = { type: '', html: '<b>중간 가격대</b>입니다. 어느 방향으로든 움직일 수 있어 추세 확인이 중요합니다.' };
  }
  $('posTip').className = 'tip ' + posTip.type;
  $('posTip').innerHTML = posTip.html;
}

function renderSignalsSection(signals) {
  $('signalsBox').innerHTML = signals.length === 0
    ? '<div class="signal"><div class="ttl">감지된 시그널 없음</div><div class="desc">데이터 기간을 늘려보세요.</div></div>'
    : signals.map(s => `
        <div class="signal ${s.type}">
          <div class="ttl">${s.title}</div>
          <div class="desc">${escapeHtml(s.desc)}</div>
          ${s.helper ? `<div class="helper">${escapeHtml(s.helper)}</div>` : ''}
        </div>
      `).join('');
}

function renderTradeSection(levels, verdict) {
  if (!levels) {
    $('tradeCard').style.display = 'none';
    return;
  }

  // 인트로
  let introType = 'tip', introHtml;
  if (verdict.score >= 1.5) {
    introType = 'good';
    introHtml = `<b>현재 기술적으로 매수 관심 구간입니다.</b> 아래 분할 매수 가격으로 나눠서 진입하는 전략을 추천합니다. 손절가 설정을 잊지 마세요.`;
  } else if (verdict.score <= -1.5) {
    introType = 'danger';
    introHtml = `<b>현재 약세 신호가 우세합니다.</b> 신규 매수보다 추세 전환을 기다리는 것이 안전합니다. 이미 보유 중이라면 손절가 라인을 점검하세요.`;
  } else {
    introType = 'warn';
    introHtml = `<b>현재 뚜렷한 매매 신호가 없습니다.</b> 아래 가격대는 "만약 매수한다면" 기준 참고 가격입니다. 박스권 매매 또는 관망이 안전합니다.`;
  }
  $('tradeIntro').className = 'tip ' + introType;
  $('tradeIntro').innerHTML = introHtml;

  // 분할 매수
  $('splitBuyList').innerHTML = levels.splitBuy.map(b => `
    <div class="split-row">
      <div>
        <div class="name">${escapeHtml(b.label)}</div>
        <div style="font-size:11px; color:var(--muted);">${escapeHtml(b.desc)}</div>
      </div>
      <div style="text-align:right;">
        <div class="price">${fmtNum(b.price, 0)}</div>
        <div class="pct">비중 ${b.pct}%</div>
      </div>
    </div>
  `).join('');
  $('avgBuyNote').innerHTML = `💡 3단계 모두 매수 시 <b>평균 단가 ${fmtNum(levels.avgBuy, 0)}</b> (현재가 대비 ${fmtPct((levels.avgBuy - levels.current) / levels.current * 100)})`;

  // 손절가
  $('stopLossPrice').textContent = fmtNum(levels.stopLoss, 0);
  $('stopLossPct').textContent = `(${fmtPct(levels.stopLossPct)})`;
  $('stopLossPct').className = 'trade-pct neg';
  $('stopLossNote').innerHTML = `이 가격 도달 시 <b>무조건 매도</b>. ATR×2 + 최근 저점 기준. <br>최대 손실: 평단 대비 약 ${fmtPct((levels.stopLoss - levels.avgBuy) / levels.avgBuy * 100)}`;

  // 1차 목표가
  $('target1Price').textContent = fmtNum(levels.target1, 0);
  $('target1Pct').textContent = `(${fmtPct(levels.target1Pct)})`;
  $('target1Note').innerHTML = `최근 20일 고점 또는 ATR×3 기준.<br>도달 시 <b>50% 익절 + 손절선을 본전으로 상향</b> 추천.`;

  // 2차 목표가
  $('target2Price').textContent = fmtNum(levels.target2, 0);
  $('target2Pct').textContent = `(${fmtPct(levels.target2Pct)})`;
  $('target2Note').innerHTML = `최근 60일 고점 또는 ATR×5 기준.<br>도달 시 <b>나머지 익절</b> 또는 추세 추격.`;

  // 손익비
  const rr1 = levels.rr1, rr2 = levels.rr2;
  $('rrValue').innerHTML = `${rr1.toFixed(2)}<span style="font-size:14px; color:var(--muted);"> / ${rr2.toFixed(2)}</span>`;
  let rrComment;
  if (rr1 >= 2) rrComment = `✅ <b>훌륭한 손익비</b> — 손실 1당 이익 ${rr1.toFixed(1)} 기대. 매매 가치 있음.`;
  else if (rr1 >= 1) rrComment = `🟡 <b>보통 손익비</b> — 1차 목표 ${rr1.toFixed(1)} : 1. 가능하면 2차까지 보유 권장.`;
  else rrComment = `⚠️ <b>낮은 손익비</b> — 1차 목표 ${rr1.toFixed(1)} : 1. 매매를 보류하거나 손절선을 더 가깝게 조정하세요.`;
  $('rrNote').innerHTML = `1차 / 2차 목표 기준. 일반적으로 <b>최소 2:1 이상</b> 권장.<br>${rrComment}`;

  // 리스크 안내
  const atrPct = levels.atr / levels.current * 100;
  let riskMsgs = [];
  riskMsgs.push(`<b>📌 매매 체크리스트</b>`);
  riskMsgs.push(`① 손절가 <b>${fmtNum(levels.stopLoss, 0)}</b>를 반드시 정해놓고 매수하세요. 손절 없는 매매는 가장 큰 손실의 원인입니다.`);
  riskMsgs.push(`② 한 종목에 전체 자산의 <b>10~20% 이내</b>로 분산하세요.`);
  riskMsgs.push(`③ 일평균 변동성(ATR) <b>${fmtNum(levels.atr, 0)}원 (${atrPct.toFixed(2)}%)</b> — ${atrPct > 4 ? '<b style="color:var(--bad)">변동성 큰 종목</b>이니 비중을 더 낮추세요.' : atrPct > 2 ? '보통 수준의 변동성입니다.' : '안정적인 종목입니다.'}`);
  riskMsgs.push(`④ 기술적 분석만으로 매매하지 말고, <b>실적·재무·뉴스</b>도 반드시 함께 확인하세요.`);
  $('tradeRiskTip').className = 'tip';
  $('tradeRiskTip').innerHTML = riskMsgs.join('<br>');
}
function volRatioText(data) {
  if (data.length < 20) return '-';
  const v5 = avg(data.slice(-5).map(d => d.volume));
  const v20 = avg(data.slice(-20).map(d => d.volume));
  if (!v20) return '-';
  return (v5 / v20).toFixed(2) + 'x';
}

/* ============================================================
 *  메인 실행
 * ========================================================== */
function runAnalysis(opts = {}) {
  hideBanner();
  setLoading(true);
  setTimeout(() => {
    try {
      const text = $('krxInput').value;
      if (!text.trim()) {
        if (opts.silentEmpty) return;
        openDataModal();
        showBanner('먼저 KRX 데이터를 붙여넣어 주세요. (모달의 안내 참고)', 'info');
        return;
      }
      saveRaw();

      const allRows = parseKRX(text);
      state.rawDaily = allRows;

      let rows = resample(allRows, state.interval);
      const start = $('startDate').value;
      const end = $('endDate').value;
      rows = filterByDate(rows, start, end);
      if (rows.length === 0) {
        showBanner('지정한 기간 내 데이터가 없습니다. 시작/종료일을 조정하거나 더 많은 데이터를 붙여넣어 주세요.', 'warn');
        return;
      }

      state.data = rows;
      state.symbol = $('symbol').value.trim() || '종목';
      saveSettings();
      renderSummary();
      renderCharts();
      updateDataStatus(allRows.length, rows.length);
      const msg = `✅ 총 ${allRows.length}개 일봉 인식 → ${rows.length}개 ${intervalLabel()} 표시 중`;
      $('parseHint').textContent = msg;
      $('modalHint').textContent = msg;
      if (opts.closeModal) closeDataModal();
    } catch (err) {
      showBanner('파싱 오류:\n' + (err.message || err), 'error');
    } finally {
      setLoading(false);
    }
  }, 50);
}
function intervalLabel() {
  return state.interval === 'DAILY' ? '일봉' : state.interval === 'WEEKLY' ? '주봉' : '월봉';
}
function updateDataStatus(rawN, shownN) {
  const el = $('dataStatus');
  if (!rawN) {
    el.className = 'data-status empty';
    el.textContent = '⚠️ 데이터 없음 — [데이터 입력]을 먼저 클릭하세요';
  } else {
    el.className = 'data-status ok';
    el.textContent = `✓ ${rawN}개 일봉 로드 · ${shownN}개 ${intervalLabel()} 표시`;
  }
}

