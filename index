<!doctype html>
<!--
  사용법:
  1) data.krx.co.kr 에서 [개별종목 시세 추이] 엑셀(.xls)을 다운로드 후 엑셀에서 엽니다.
  2) 표의 헤더 줄부터 데이터 끝까지 선택해 복사(Ctrl+C)합니다.
  3) 이 페이지의 "KRX 데이터" 영역에 붙여넣기(Ctrl+V) 합니다.
  4) 종목명·기간·봉종류를 설정한 뒤 [분석 시작]을 누릅니다.
  5) 보조지표 토글로 MA/BB/RSI/MACD 등을 켜고 끌 수 있습니다.
-->
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>KRX 주식 기술적 분석</title>
  <script src="https://unpkg.com/lightweight-charts@4.1.3/dist/lightweight-charts.standalone.production.js"></script>
  <script src="https://unpkg.com/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
  <style>
    :root {
      --bg: #0f1115;
      --panel: #161a22;
      --panel-2: #1d2330;
      --border: #2a3142;
      --text: #e6e9ef;
      --muted: #8a93a6;
      --accent: #4f8cff;
      --up: #ef4444;
      --down: #2563eb;
      --warn: #f59e0b;
      --good: #10b981;
      --bad: #ef4444;
      --shadow: 0 2px 12px rgba(0,0,0,0.35);
    }
    :root.light {
      --bg: #f5f6fa;
      --panel: #ffffff;
      --panel-2: #f0f2f7;
      --border: #d9dde6;
      --text: #16181d;
      --muted: #5e6470;
      --accent: #2563eb;
      --shadow: 0 2px 10px rgba(0,0,0,0.08);
    }
    * { box-sizing: border-box; }
    html, body {
      margin: 0; padding: 0;
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Pretendard",
                   "Apple SD Gothic Neo", "Malgun Gothic", Roboto, sans-serif;
      font-size: 14px;
      line-height: 1.45;
    }
    .container { max-width: 1280px; margin: 0 auto; padding: 16px; }
    header {
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 12px; margin-bottom: 16px;
    }
    header h1 { font-size: 18px; font-weight: 600; margin: 0; letter-spacing: -0.2px; }

    /* ---- 입력 카드 sticky ---- */
    .card.sticky-input {
      position: sticky;
      top: 0;
      z-index: 90;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
      border-color: var(--accent);
      transition: padding 0.2s ease;
    }
    :root.light .card.sticky-input {
      box-shadow: 0 2px 14px rgba(0, 0, 0, 0.10);
    }
    /* 모바일 sticky 미니 모드 */
    .card.sticky-input.mini {
      padding: 8px 12px;
    }
    .card.sticky-input.mini .form-grid,
    .card.sticky-input.mini .row {
      display: none;
    }
    .card.sticky-input.mini .mini-bar {
      display: flex;
    }
    .mini-bar {
      display: none;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .mini-bar .mini-title {
      flex: 1;
      font-size: 14px;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .mini-bar .mini-pct { font-size: 12px; font-weight: 600; }
    .mini-bar button {
      padding: 4px 10px;
      font-size: 12px;
    }

    /* ---- ▲▼ 화살표 및 색맹 보조 ---- */
    .arrow-up::before { content: "▲ "; font-size: 0.85em; }
    .arrow-down::before { content: "▼ "; font-size: 0.85em; }
    .arrow-flat::before { content: "▬ "; font-size: 0.85em; }
    .pos { color: var(--up); font-variant-numeric: tabular-nums; }
    .neg { color: var(--down); font-variant-numeric: tabular-nums; }
    .pos.strong, .neg.strong { font-weight: 700; }

    /* ---- 오래된 데이터 경고 ---- */
    .stale-warn {
      background: rgba(245, 158, 11, 0.15);
      border: 1px solid rgba(245, 158, 11, 0.4);
      color: #fcd34d;
      padding: 8px 14px;
      border-radius: 8px;
      margin-bottom: 12px;
      font-size: 13px;
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .stale-warn b { color: #fde68a; }

    /* ---- CSV 미리보기 ---- */
    .csv-preview {
      background: var(--panel-2);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 8px 10px;
      margin-top: 6px;
      font-size: 11px;
      color: var(--muted);
    }
    .csv-preview.ok { border-color: var(--good); color: var(--good); }
    .csv-preview.bad { border-color: var(--bad); color: var(--bad); }
    .csv-preview b { color: var(--text); }

    /* ---- 가격 알림 배너 ---- */
    .alert-banner {
      padding: 12px 14px;
      border-radius: 8px;
      margin-bottom: 12px;
      font-size: 14px;
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      animation: pulseAlert 2s ease-in-out;
    }
    .alert-banner.danger {
      background: rgba(239, 68, 68, 0.15);
      border: 2px solid rgba(239, 68, 68, 0.6);
      color: #fca5a5;
    }
    .alert-banner.good {
      background: rgba(16, 185, 129, 0.15);
      border: 2px solid rgba(16, 185, 129, 0.6);
      color: #6ee7b7;
    }
    .alert-banner b { color: var(--text); }
    @keyframes pulseAlert {
      0%, 100% { box-shadow: 0 0 0 0 transparent; }
      50% { box-shadow: 0 0 0 8px rgba(239, 68, 68, 0.2); }
    }

    /* ---- 워치리스트 ---- */
    .tabs {
      display: flex;
      gap: 4px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 14px;
    }
    .tab-btn {
      background: transparent;
      border: none;
      color: var(--muted);
      padding: 8px 16px;
      cursor: pointer;
      font-family: inherit;
      font-size: 13px;
      font-weight: 500;
      border-bottom: 2px solid transparent;
      margin-bottom: -1px;
    }
    .tab-btn:hover { color: var(--text); }
    .tab-btn.active {
      color: var(--accent);
      border-bottom-color: var(--accent);
      font-weight: 600;
    }
    .watchlist-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 10px;
      max-height: 500px;
      overflow-y: auto;
    }
    .watch-card {
      background: var(--panel-2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 12px 14px;
      cursor: pointer;
      transition: all 0.15s;
    }
    .watch-card:hover {
      border-color: var(--accent);
      transform: translateY(-1px);
    }
    .watch-card .w-title {
      font-weight: 700; font-size: 14px;
      margin-bottom: 4px;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .watch-card .w-meta { font-size: 11px; color: var(--muted); margin-bottom: 6px; }
    .watch-card .w-price {
      font-size: 18px; font-weight: 700;
      display: flex; align-items: baseline; gap: 6px;
    }
    .watch-card .w-pct { font-size: 12px; font-weight: 600; }
    .watch-card .w-score {
      display: inline-block;
      background: var(--bg);
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 600;
      margin-top: 6px;
    }
    .watch-card .w-mini {
      font-size: 11px;
      color: var(--muted);
      margin-top: 4px;
      line-height: 1.5;
    }
    .watch-card .w-mini b { color: var(--text); }

    /* ---- 설정 모달 ---- */
    .setting-row {
      padding: 10px 0;
      border-bottom: 1px solid var(--border);
    }
    .setting-row:last-child { border-bottom: none; }
    .setting-row label.s-name {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 2px;
    }
    .setting-row .s-desc { font-size: 11px; color: var(--muted); margin-bottom: 6px; }
    .setting-row select, .setting-row input[type="number"] {
      width: 140px;
      background: var(--panel-2);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 6px 8px;
      font-size: 13px;
      font-family: inherit;
    }
    .setting-row .checkbox-row {
      display: flex; align-items: center; gap: 8px;
    }
    .setting-row .checkbox-row input[type="checkbox"] {
      width: 16px; height: 16px; cursor: pointer;
    }

    /* ---- 도움말(투어) 오버레이 ---- */
    .tour-overlay {
      display: none;
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.7);
      z-index: 2000;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }
    .tour-overlay.show { display: flex; }
    .tour-box {
      background: var(--panel);
      border: 1px solid var(--accent);
      border-radius: 12px;
      padding: 22px 24px;
      max-width: 480px;
      width: 100%;
      box-shadow: 0 12px 40px rgba(0,0,0,0.6);
    }
    .tour-step { font-size: 11px; color: var(--accent); font-weight: 600; letter-spacing: 1px; }
    .tour-title { font-size: 18px; font-weight: 700; margin: 6px 0 10px; }
    .tour-body { font-size: 14px; line-height: 1.7; color: var(--text); }
    .tour-body b { color: var(--accent); }
    .tour-nav {
      display: flex; justify-content: space-between; align-items: center;
      margin-top: 18px; gap: 8px;
    }
    .tour-dots { display: flex; gap: 4px; }
    .tour-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--border);
    }
    .tour-dot.active { background: var(--accent); }

    /* ---- KRX 갱신 링크 ---- */
    .krx-link {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: var(--panel-2);
      color: var(--accent);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 5px 10px;
      font-size: 11px;
      text-decoration: none;
      cursor: pointer;
    }
    .krx-link:hover { border-color: var(--accent); }

    /* ---- 최근 종목 드롭다운 ---- */
    .recent-wrap {
      position: relative;
      display: inline-block;
    }
    .recent-menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      margin-top: 4px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 8px;
      box-shadow: 0 6px 20px rgba(0,0,0,0.3);
      z-index: 95;
      min-width: 220px;
      max-height: 320px;
      overflow-y: auto;
    }
    .recent-menu.show { display: block; }
    .recent-item {
      padding: 8px 12px;
      cursor: pointer;
      font-size: 13px;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
    }
    .recent-item:last-child { border-bottom: none; }
    .recent-item:hover { background: var(--panel-2); }
    .recent-item .r-name { font-weight: 600; }
    .recent-item .r-meta { font-size: 11px; color: var(--muted); }

    /* ---- 차트 위 사용자 가격선 패널 ---- */
    .user-prices {
      background: var(--panel-2);
      border-radius: 8px;
      padding: 10px 12px;
      margin-top: 10px;
    }
    .user-prices .up-title {
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 6px;
    }
    .user-prices .up-form {
      display: flex; gap: 6px; flex-wrap: wrap; align-items: center;
    }
    .user-prices .up-form input {
      padding: 5px 8px; font-size: 12px;
      background: var(--panel); color: var(--text);
      border: 1px solid var(--border); border-radius: 6px;
      width: 110px;
    }
    .user-prices .up-form input[type="color"] {
      width: 40px; padding: 2px; cursor: pointer;
    }
    .user-prices .up-list { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 6px; }
    .up-chip {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 3px 8px;
      font-size: 11px;
    }
    .up-chip .x-btn {
      cursor: pointer;
      color: var(--muted);
      padding: 0 4px;
    }
    .up-chip .x-btn:hover { color: var(--bad); }

    /* ---- 비교 모드 ---- */
    .compare-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    .compare-col {
      background: var(--panel-2);
      border-radius: 10px;
      padding: 12px;
    }
    .compare-col h4 {
      margin: 0 0 8px;
      font-size: 14px;
      color: var(--accent);
    }
    .compare-row {
      display: flex;
      justify-content: space-between;
      padding: 6px 0;
      border-bottom: 1px dashed var(--border);
      font-size: 13px;
    }
    .compare-row:last-child { border-bottom: none; }
    .compare-row .cr-label { color: var(--muted); }
    @media (max-width: 700px) {
      .compare-grid { grid-template-columns: 1fr; }
    }

    /* ---- 스크롤 이동 핸들 (우측 하단 고정) ---- */
    .scroll-handles {
      position: fixed;
      right: 16px;
      bottom: 16px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      z-index: 95;
      pointer-events: none;
    }
    .scroll-handle {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--panel);
      color: var(--text);
      border: 1px solid var(--border);
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
      cursor: pointer;
      font-size: 18px;
      font-weight: 700;
      line-height: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: opacity 0.2s, transform 0.15s, background 0.15s, color 0.15s;
      opacity: 0.75;
      pointer-events: auto;
      user-select: none;
      padding: 0;
      font-family: inherit;
    }
    .scroll-handle:hover {
      opacity: 1;
      transform: scale(1.08);
      background: var(--accent);
      color: #fff;
      border-color: var(--accent);
    }
    .scroll-handle:active { transform: scale(0.96); }
    .scroll-handle.disabled {
      opacity: 0.25;
      cursor: default;
      pointer-events: none;
    }
    :root.light .scroll-handle {
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
    }
    @media (max-width: 600px) {
      .scroll-handles { right: 10px; bottom: 10px; }
      .scroll-handle { width: 40px; height: 40px; font-size: 16px; }
    }

    /* ---- 인쇄용 스타일 ---- */
    @media print {
      body, html { background: white !important; color: black !important; font-size: 11px; }
      header, .modal, #indicatorCard, #glossaryCard, .sticky-input,
      .tour-overlay, .toast, #banner, .stale-warn, .scroll-handles { display: none !important; }
      .card { box-shadow: none !important; border: 1px solid #ccc !important; page-break-inside: avoid; }
      .chart-wrap { page-break-inside: avoid; }
      .card.collapsible.collapsed > *:not(.section-title) { display: block !important; }
      * { color: black !important; background: white !important; }
      .pos { color: #d00 !important; }
      .neg { color: #00d !important; }
      .container { padding: 0 !important; max-width: 100% !important; }
      .signal, .stat, .trade-box, .pos-stat { border: 1px solid #ddd; page-break-inside: avoid; }
    }
    .theme-toggle {
      background: var(--panel); color: var(--text);
      border: 1px solid var(--border); border-radius: 8px;
      padding: 6px 12px; cursor: pointer; font-size: 13px;
    }
    .card {
      background: var(--panel); border: 1px solid var(--border);
      border-radius: 12px; padding: 16px;
      box-shadow: var(--shadow); margin-bottom: 16px;
    }
    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 12px;
    }
    label { display: block; font-size: 12px; color: var(--muted); margin-bottom: 4px; }
    input[type="text"], input[type="date"], select, textarea {
      width: 100%;
      background: var(--panel-2); color: var(--text);
      border: 1px solid var(--border); border-radius: 8px;
      padding: 8px 10px; font-size: 14px; font-family: inherit;
    }
    input:focus, select:focus, textarea:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
    .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .btn {
      background: var(--accent); color: #fff; border: none;
      border-radius: 8px; padding: 9px 16px;
      font-size: 14px; font-weight: 600; cursor: pointer;
    }
    .btn:disabled { opacity: 0.6; cursor: not-allowed; }
    .btn.ghost {
      background: transparent; color: var(--text);
      border: 1px solid var(--border);
    }
    .btn.ghost.active { background: var(--accent); color: #fff; border-color: var(--accent); }
    .indicator-bar { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .indicator-bar .btn { padding: 6px 10px; font-size: 12px; font-weight: 500; }
    .banner {
      display: none;
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(239, 68, 68, 0.4);
      color: #fca5a5;
      padding: 10px 14px; border-radius: 8px; margin-bottom: 12px;
    }
    .banner.show { display: block; }
    .banner.warn { background: rgba(245,158,11,0.12); border-color: rgba(245,158,11,0.4); color: #fcd34d; line-height: 1.6; }
    .banner.info { background: rgba(79, 140, 255, 0.12); border-color: rgba(79, 140, 255, 0.4); color: #93c5fd; }
    .banner a { color: inherit; text-decoration: underline; }
    .toast {
      position: fixed; top: 16px; right: 16px;
      background: var(--panel); color: var(--text);
      border: 1px solid var(--border); padding: 10px 14px;
      border-radius: 8px; box-shadow: var(--shadow);
      z-index: 1000; max-width: 360px;
      opacity: 0; transform: translateY(-8px);
      transition: all 0.2s;
    }
    .toast.show { opacity: 1; transform: translateY(0); }
    .summary-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
    }
    .stat { background: var(--panel-2); border-radius: 10px; padding: 12px; }
    .stat .lbl { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; }
    .stat .val { font-size: 18px; font-weight: 600; margin-top: 4px; }
    .stat .sub { font-size: 12px; color: var(--muted); margin-top: 2px; }
    .pos { color: var(--up); }
    .neg { color: var(--down); }
    .signals {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 8px; margin-top: 12px;
    }
    .signal {
      background: var(--panel-2);
      border-left: 3px solid var(--muted);
      padding: 8px 12px; border-radius: 6px; font-size: 13px;
    }
    .signal.good { border-left-color: var(--good); }
    .signal.bad  { border-left-color: var(--bad); }
    .signal.warn { border-left-color: var(--warn); }
    .signal .ttl { font-weight: 600; }
    .signal .desc { color: var(--muted); font-size: 12px; margin-top: 2px; }
    .verdict {
      margin-top: 12px; background: var(--panel-2);
      border-radius: 10px; padding: 14px 16px;
      border-left: 4px solid var(--accent);
    }
    .verdict .v-title { font-size: 18px; font-weight: 700; }
    .verdict ul { margin: 8px 0 0 18px; padding: 0; color: var(--muted); font-size: 13px; line-height: 1.6; }
    .verdict-desc { font-size: 13px; color: var(--text); margin-top: 8px; line-height: 1.6; }
    .disclaimer { margin-top: 10px; font-size: 11px; color: var(--muted); font-style: italic; }

    /* ---- 매매 가이드 카드 ---- */
    .trade-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 10px;
    }
    .trade-box {
      background: var(--panel-2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 12px 14px;
      border-left: 4px solid var(--muted);
    }
    .trade-box.buy { border-left-color: #10b981; }
    .trade-box.stop { border-left-color: #ef4444; }
    .trade-box.target { border-left-color: #eab308; }
    .trade-box.target2 { border-left-color: #84cc16; }
    .trade-box.rr { border-left-color: #a855f7; }
    .trade-lbl {
      font-size: 12px; color: var(--muted);
      margin-bottom: 4px; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.5px;
    }
    .trade-price { font-size: 22px; font-weight: 700; }
    .trade-pct { font-size: 13px; margin-left: 6px; }
    .trade-note { font-size: 11px; color: var(--muted); margin-top: 6px; line-height: 1.5; }
    .split-row {
      display: flex; justify-content: space-between; align-items: baseline;
      padding: 6px 0; font-size: 13px;
      border-bottom: 1px dashed var(--border);
    }
    .split-row:last-child { border-bottom: none; }
    .split-row .name { font-size: 12px; color: var(--muted); }
    .split-row .price { font-weight: 600; font-size: 14px; }
    .split-row .pct { color: var(--accent); font-weight: 600; font-size: 11px; }

    /* ---- 점수 ---- */
    .score-main {
      display: flex; align-items: center; gap: 16px;
      padding: 16px;
      background: var(--panel-2);
      border-radius: 12px;
      margin-bottom: 12px;
    }
    .score-circle {
      width: 88px; height: 88px;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      flex-direction: column;
      flex-shrink: 0;
      background: conic-gradient(var(--score-color, var(--accent)) calc(var(--score-val, 50) * 1%), var(--bg) 0);
      position: relative;
    }
    .score-circle::before {
      content: '';
      position: absolute;
      inset: 8px;
      background: var(--panel-2);
      border-radius: 50%;
    }
    .score-circle .score-num {
      position: relative; z-index: 1;
      font-size: 24px; font-weight: 700;
    }
    .score-circle .score-lbl {
      position: relative; z-index: 1;
      font-size: 10px; color: var(--muted);
    }
    .score-detail { flex: 1; }
    .score-detail h3 { margin: 0 0 4px; font-size: 16px; }
    .score-detail .score-sub { font-size: 12px; color: var(--muted); }
    .score-breakdown {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 8px;
    }
    .score-item {
      background: var(--panel-2);
      border-radius: 8px;
      padding: 8px 10px;
    }
    .score-item .name {
      font-size: 12px; color: var(--muted);
      display: flex; justify-content: space-between;
      margin-bottom: 4px;
    }
    .score-item .name b { color: var(--text); }
    .score-bar {
      height: 6px;
      background: var(--bg);
      border-radius: 3px;
      overflow: hidden;
    }
    .score-bar > div {
      height: 100%; border-radius: 3px;
      transition: width 0.4s;
    }
    .score-item .desc { font-size: 11px; color: var(--muted); margin-top: 4px; }

    /* ---- 친절한 팁/주의 박스 ---- */
    .tip {
      background: rgba(79,140,255,0.08);
      border-left: 3px solid var(--accent);
      padding: 10px 14px;
      border-radius: 6px;
      font-size: 13px;
      margin-top: 10px;
      color: var(--text);
      line-height: 1.6;
    }
    .tip.warn {
      background: rgba(245,158,11,0.08);
      border-left-color: var(--warn);
    }
    .tip.danger {
      background: rgba(239,68,68,0.08);
      border-left-color: var(--bad);
    }
    .tip.good {
      background: rgba(16,185,129,0.08);
      border-left-color: var(--good);
    }
    .tip b { color: var(--accent); }
    .tip.warn b { color: var(--warn); }
    .tip.danger b { color: var(--bad); }
    .tip.good b { color: var(--good); }

    /* ---- 가격 위치 바 ---- */
    .range-bar {
      position: relative;
      height: 24px;
      background: linear-gradient(90deg, #2563eb 0%, #eab308 50%, #ef4444 100%);
      border-radius: 12px;
      margin: 12px 0 4px;
      opacity: 0.85;
    }
    .range-marker {
      position: absolute; top: -3px;
      width: 4px; height: 30px;
      background: #fff;
      border-radius: 2px;
      box-shadow: 0 0 8px rgba(0,0,0,0.5);
      transform: translateX(-50%);
    }
    .range-labels {
      display: flex; justify-content: space-between;
      font-size: 11px; color: var(--muted);
    }

    /* ---- 시그널 해설 ---- */
    .signal .helper {
      font-size: 11px; color: var(--muted);
      margin-top: 6px; padding-top: 6px;
      border-top: 1px dashed var(--border);
      line-height: 1.5;
    }

    /* ---- 용어 사전 ---- */
    .glossary { font-size: 13px; line-height: 1.7; }
    .glossary dt { font-weight: 600; color: var(--text); margin-top: 10px; }
    .glossary dd { margin: 2px 0 6px 0; color: var(--muted); font-size: 12px; line-height: 1.6; }
    .glossary dd b { color: var(--text); }

    .section-title {
      font-size: 14px; font-weight: 700; margin: 4px 0 10px;
      display: flex; align-items: center; gap: 8px;
    }
    .section-title .badge {
      font-size: 11px; font-weight: 500; color: var(--muted);
      background: var(--panel-2); padding: 2px 8px; border-radius: 999px;
    }

    /* ---- 접힘/펼침 ---- */
    .card.collapsible > .section-title {
      cursor: pointer;
      user-select: none;
      margin-bottom: 10px;
    }
    .card.collapsible > .section-title:hover { color: var(--accent); }
    .section-title .chevron-c {
      margin-left: auto;
      font-size: 11px;
      color: var(--muted);
      transition: transform 0.2s;
      flex-shrink: 0;
      padding: 4px 6px;
      border-radius: 4px;
    }
    .card.collapsible > .section-title:hover .chevron-c {
      background: var(--panel-2);
      color: var(--accent);
    }
    .card.collapsible.collapsed > .section-title { margin-bottom: 0; }
    .card.collapsible.collapsed > .section-title .chevron-c {
      transform: rotate(-90deg);
    }
    .card.collapsible.collapsed > *:not(.section-title) {
      display: none !important;
    }

    /* ---- 툴팁 (마우스 호버 설명) ---- */
    [data-tip] { position: relative; }
    [data-tip]:hover::after {
      content: attr(data-tip);
      position: absolute;
      bottom: calc(100% + 8px);
      left: 50%;
      transform: translateX(-50%);
      background: var(--panel-2);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px 12px;
      font-size: 12px;
      font-weight: 400;
      white-space: pre-wrap;
      width: max-content;
      max-width: 280px;
      z-index: 1100;
      box-shadow: 0 4px 16px rgba(0,0,0,0.4);
      pointer-events: none;
      line-height: 1.55;
      text-transform: none;
      text-align: left;
      letter-spacing: normal;
    }
    [data-tip]:hover::before {
      content: '';
      position: absolute;
      bottom: calc(100% + 3px);
      left: 50%;
      transform: translateX(-50%);
      border: 5px solid transparent;
      border-top-color: var(--border);
      z-index: 1100;
      pointer-events: none;
    }
    [data-tip-pos="bottom"]:hover::after {
      bottom: auto;
      top: calc(100% + 8px);
    }
    [data-tip-pos="bottom"]:hover::before {
      bottom: auto;
      top: calc(100% + 3px);
      border-top-color: transparent;
      border-bottom-color: var(--border);
    }

    /* ---- 차트 범례 ---- */
    .chart-legend {
      display: flex; flex-wrap: wrap;
      gap: 6px 14px;
      padding: 4px 10px 8px;
      font-size: 11px;
      color: var(--muted);
      align-items: center;
    }
    .chart-legend .legend-empty {
      color: var(--muted); font-style: italic;
    }
    .legend-item {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: help;
      padding: 2px 4px;
      border-radius: 4px;
      transition: background 0.15s;
    }
    .legend-item:hover { color: var(--text); background: var(--panel-2); }
    .legend-dot {
      display: inline-block;
      width: 16px; height: 3px;
      border-radius: 2px;
      flex-shrink: 0;
    }
    .legend-dot.dashed {
      background: repeating-linear-gradient(
        90deg,
        var(--dc, currentColor) 0,
        var(--dc, currentColor) 4px,
        transparent 4px,
        transparent 7px
      );
    }
    .legend-dot.dotted {
      background: repeating-linear-gradient(
        90deg,
        var(--dc, currentColor) 0,
        var(--dc, currentColor) 2px,
        transparent 2px,
        transparent 4px
      );
    }
    .legend-dot.box { height: 10px; width: 12px; border-radius: 2px; }
    .legend-item b { color: var(--text); font-weight: 600; }

    /* ---- 시나리오 테이블 ---- */
    .scenario-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
      margin-top: 8px;
    }
    .scenario-table th, .scenario-table td {
      padding: 8px 6px;
      text-align: right;
      border-bottom: 1px solid var(--border);
    }
    .scenario-table th {
      background: var(--panel-2);
      color: var(--muted);
      font-weight: 600;
      text-align: center;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }
    .scenario-table tr.current { background: rgba(79,140,255,0.12); }
    .scenario-table tr.current td { font-weight: 600; }
    .scenario-table tr.down td:first-child { color: var(--down); font-weight: 700; }
    .scenario-table tr.up td:first-child { color: var(--up); font-weight: 700; }
    .scenario-table td:first-child { text-align: center; }
    .scenario-table td.note { font-size: 11px; color: var(--muted); text-align: left; max-width: 180px; }
    .scenario-table tbody tr:hover { background: var(--panel-2); }
    .scenario-pill {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 600;
    }
    .scroll-x { overflow-x: auto; }

    /* ---- 빠른 입력 폼 ---- */
    .quick-form {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 10px;
      margin-top: 8px;
    }
    .quick-form input[type="number"] {
      width: 100%;
      background: var(--panel-2);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 8px 10px;
      font-size: 14px;
      font-family: inherit;
    }
    .quick-info {
      background: var(--panel-2);
      border-radius: 8px;
      padding: 10px 12px;
      font-size: 12px;
      color: var(--muted);
      margin-top: 10px;
    }
    .quick-info b { color: var(--text); }

    /* ---- 포지션 분석 ---- */
    .position-form {
      display: grid;
      grid-template-columns: 1fr 1fr auto;
      gap: 10px;
      align-items: end;
      padding: 12px 14px;
      background: var(--panel-2);
      border-radius: 10px;
      margin-bottom: 12px;
    }
    .position-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 10px;
      margin-bottom: 12px;
    }
    .pos-stat {
      background: var(--panel-2);
      border-radius: 10px;
      padding: 12px 14px;
      border-left: 4px solid var(--accent);
    }
    .pos-stat.profit { border-left-color: #10b981; }
    .pos-stat.loss { border-left-color: #ef4444; }
    .pos-stat.warn { border-left-color: #eab308; }
    .pos-stat .pos-lbl {
      font-size: 11px; color: var(--muted);
      text-transform: uppercase; letter-spacing: 0.5px;
    }
    .pos-stat .pos-val { font-size: 20px; font-weight: 700; margin-top: 4px; }
    .pos-stat .pos-sub { font-size: 12px; color: var(--muted); margin-top: 2px; }
    .pos-section-title {
      font-size: 14px; font-weight: 600;
      margin: 4px 0 8px;
      color: var(--text);
    }

    /* ---- 포지션 사이드바 레이아웃 ---- */
    .pos-container {
      display: grid;
      grid-template-columns: 220px 1fr;
      gap: 14px;
      margin-top: 14px;
    }
    .pos-sidebar {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .pos-sidebar-btn {
      background: var(--panel-2);
      border: 1px solid var(--border);
      border-left: 3px solid transparent;
      border-radius: 8px;
      padding: 12px 14px;
      cursor: pointer;
      text-align: left;
      font-family: inherit;
      font-size: 13px;
      color: var(--text);
      transition: all 0.15s;
      line-height: 1.4;
    }
    .pos-sidebar-btn:hover {
      background: var(--bg);
      border-color: var(--accent);
    }
    .pos-sidebar-btn.active {
      background: var(--accent);
      color: #fff;
      border-color: var(--accent);
      border-left-color: #fff;
    }
    .pos-sidebar-btn .btn-name {
      font-weight: 600;
      display: block;
      margin-bottom: 2px;
    }
    .pos-sidebar-btn .btn-sub {
      font-size: 11px;
      color: var(--muted);
      display: block;
    }
    .pos-sidebar-btn.active .btn-sub { color: rgba(255,255,255,0.85); }
    .pos-content {
      min-width: 0;
      background: var(--panel-2);
      border-radius: 10px;
      padding: 14px;
    }
    .pos-empty {
      text-align: center;
      padding: 30px 12px;
      background: var(--panel-2);
      border-radius: 10px;
      color: var(--muted);
      font-size: 13px;
    }

    /* ---- 커스텀 추가매수 폼 ---- */
    .custom-addbuy-form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      padding: 12px 14px;
      background: var(--panel);
      border: 1px solid var(--accent);
      border-radius: 10px;
      margin-bottom: 14px;
    }
    .custom-addbuy-form .field-label {
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 4px;
    }
    .custom-addbuy-form input {
      width: 100%;
      background: var(--panel-2);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 8px 10px;
      font-size: 14px;
      font-family: inherit;
    }
    .custom-addbuy-result {
      grid-column: 1 / -1;
      font-size: 13px;
      padding: 10px 12px;
      background: var(--panel-2);
      border-radius: 8px;
      margin-top: 4px;
      line-height: 1.8;
      color: var(--text);
    }
    @media (max-width: 600px) {
      .custom-addbuy-form { grid-template-columns: 1fr; }
    }

    /* ---- 공유 모달 ---- */
    .share-options {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 8px;
      margin-bottom: 14px;
    }
    .share-option {
      text-align: left;
      padding: 12px 14px;
      cursor: pointer;
      background: var(--panel-2);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-family: inherit;
      transition: all 0.15s;
    }
    .share-option:hover {
      border-color: var(--accent);
      background: var(--bg);
    }
    .share-option.active {
      background: var(--accent);
      color: #fff;
      border-color: var(--accent);
    }
    .share-option .opt-name { font-weight: 600; font-size: 14px; }
    .share-option .opt-sub { font-size: 11px; color: var(--muted); margin-top: 4px; }
    .share-option.active .opt-sub { color: rgba(255, 255, 255, 0.85); }

    .share-preview {
      background: var(--panel-2);
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-top: 12px;
      overflow: hidden;
      text-align: center;
      max-height: 440px;
      overflow-y: auto;
    }
    .share-preview img {
      max-width: 100%;
      display: block;
      margin: 0 auto;
    }
    .share-preview-empty {
      padding: 60px 20px;
      color: var(--muted);
      font-size: 13px;
    }

    /* ---- 저장 / 불러오기 ---- */
    .save-form {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 10px;
      align-items: end;
      background: var(--panel-2);
      padding: 12px 14px;
      border-radius: 10px;
      margin-bottom: 8px;
    }
    .save-form input {
      width: 100%;
      background: var(--panel);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 8px 10px;
      font-size: 14px;
      font-family: inherit;
    }
    .saved-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      max-height: 460px;
      overflow-y: auto;
      padding-right: 4px;
    }
    .saved-item {
      background: var(--panel-2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 12px 14px;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 12px;
      align-items: start;
      transition: all 0.15s;
    }
    .saved-item:hover {
      border-color: var(--accent);
    }
    .saved-item .si-title {
      font-weight: 600;
      font-size: 14px;
      margin-bottom: 4px;
      color: var(--text);
    }
    .saved-item .si-meta {
      font-size: 11px;
      color: var(--muted);
      display: flex;
      gap: 4px 10px;
      flex-wrap: wrap;
    }
    .saved-item .si-meta b { color: var(--text); }
    .saved-item .si-levels {
      font-size: 12px;
      color: var(--muted);
      margin-top: 8px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 4px 12px;
      padding-top: 8px;
      border-top: 1px dashed var(--border);
    }
    .saved-item .si-levels span b { color: var(--text); }
    .saved-item .si-actions {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .saved-item .si-actions button {
      padding: 6px 12px;
      font-size: 12px;
      white-space: nowrap;
    }
    .saved-empty {
      text-align: center;
      padding: 30px 12px;
      color: var(--muted);
      font-size: 13px;
      background: var(--panel-2);
      border-radius: 8px;
    }
    @media (max-width: 600px) {
      .save-form { grid-template-columns: 1fr; }
      .saved-item { grid-template-columns: 1fr; }
      .saved-item .si-actions { flex-direction: row; }
    }
    @media (max-width: 768px) {
      .pos-container { grid-template-columns: 1fr; }
      .pos-sidebar {
        flex-direction: row;
        overflow-x: auto;
        padding-bottom: 4px;
      }
      .pos-sidebar-btn {
        flex-shrink: 0;
        min-width: 160px;
        border-left: 1px solid var(--border);
        border-top: 3px solid transparent;
      }
      .pos-sidebar-btn.active {
        border-left-color: var(--accent);
        border-top-color: #fff;
      }
    }
    @media (max-width: 600px) {
      .position-form { grid-template-columns: 1fr 1fr; }
      .position-form > button { grid-column: 1 / -1; }
    }
    .charts { display: grid; grid-template-columns: 1fr; gap: 12px; }
    .chart-wrap {
      background: var(--panel); border: 1px solid var(--border);
      border-radius: 12px; padding: 8px;
      box-shadow: var(--shadow);
    }
    .chart-title {
      padding: 4px 8px; font-size: 12px; color: var(--muted);
      font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;
    }
    .chart { width: 100%; height: 460px; }
    .chart.small { height: 160px; }
    .spinner {
      display: none; width: 22px; height: 22px;
      border: 3px solid rgba(255,255,255,0.2);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    .spinner.show { display: inline-block; }
    @keyframes spin { to { transform: rotate(360deg); } }
    textarea#krxInput {
      min-height: 140px; resize: vertical;
      font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      font-size: 12px; white-space: pre;
    }
    .hint { font-size: 12px; color: var(--muted); margin-top: 4px; }
    .radio-group { display: flex; gap: 6px; }
    .radio-group .pill {
      flex: 1; text-align: center;
      padding: 8px 4px; border: 1px solid var(--border);
      border-radius: 8px; cursor: pointer;
      background: var(--panel-2); font-size: 13px;
    }
    .radio-group .pill.active { background: var(--accent); color: #fff; border-color: var(--accent); }
    .guide {
      background: var(--panel-2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 14px; margin-bottom: 12px;
    }
    .guide summary {
      cursor: pointer; font-weight: 600; font-size: 14px;
      padding: 4px 0; list-style: none;
    }
    .guide summary::-webkit-details-marker { display: none; }
    .guide summary::before {
      content: "▶"; display: inline-block; margin-right: 6px;
      transition: transform 0.15s; font-size: 10px;
    }
    .guide[open] summary::before { transform: rotate(90deg); }
    .guide-body { margin-top: 8px; font-size: 13px; line-height: 1.65; }
    .guide-body p { margin: 10px 0 4px; }
    .guide-body ul, .guide-body ol { margin: 4px 0 8px 22px; padding: 0; }
    .guide-body li { margin: 4px 0; }
    .guide-body a { color: var(--accent); text-decoration: none; }
    .guide-body a:hover { text-decoration: underline; }
    .guide-body pre {
      background: var(--bg); border: 1px solid var(--border);
      border-radius: 6px; padding: 8px 10px;
      font-size: 12px; overflow-x: auto; margin: 4px 0;
    }
    .guide-body code, code {
      background: var(--bg); border: 1px solid var(--border);
      border-radius: 4px; padding: 1px 5px; font-size: 12px;
    }
    kbd {
      background: var(--bg); border: 1px solid var(--border);
      border-bottom-width: 2px; border-radius: 4px;
      padding: 1px 6px; font-size: 11px;
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
    }
    .col-list {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 4px 12px; margin: 4px 0;
    }
    .col-list span { font-size: 12px; color: var(--muted); }
    .col-list b { color: var(--text); }

    /* ---- 모달 ---- */
    .modal {
      display: none;
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.65);
      z-index: 1000;
      align-items: flex-start;
      justify-content: center;
      padding: 24px 16px;
      overflow-y: auto;
      backdrop-filter: blur(4px);
    }
    .modal.show { display: flex; }
    .modal-content {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 12px;
      width: 100%;
      max-width: 900px;
      display: flex;
      flex-direction: column;
      box-shadow: 0 10px 40px rgba(0,0,0,0.5);
      max-height: calc(100vh - 48px);
    }
    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 18px;
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
    }
    .modal-header h2 { margin: 0; font-size: 16px; font-weight: 600; }
    .modal-close {
      background: transparent;
      border: none;
      color: var(--muted);
      font-size: 26px;
      cursor: pointer;
      width: 32px; height: 32px;
      border-radius: 6px;
      line-height: 1;
      padding: 0;
    }
    .modal-close:hover { background: var(--panel-2); color: var(--text); }
    .modal-body {
      padding: 16px 18px;
      overflow-y: auto;
      flex: 1;
    }
    .modal-footer {
      padding: 12px 18px;
      border-top: 1px solid var(--border);
      display: flex;
      gap: 8px;
      justify-content: flex-end;
      align-items: center;
      flex-shrink: 0;
      flex-wrap: wrap;
    }
    .modal-footer .hint { margin: 0; flex: 1; }
    .data-status {
      display: inline-flex; align-items: center;
      gap: 6px;
      background: var(--panel-2);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 4px 12px;
      font-size: 12px;
      color: var(--muted);
    }
    .data-status.ok { color: var(--good); border-color: rgba(16, 185, 129, 0.4); }
    .data-status.empty { color: var(--warn); border-color: rgba(245, 158, 11, 0.4); }

    @media (max-width: 600px) {
      .container { padding: 10px; }
      .chart { height: 360px; }
      .chart.small { height: 130px; }
      header h1 { font-size: 16px; }
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>📈 KRX 주식 기술적 분석</h1>
      <div style="display:flex; gap:6px; flex-wrap:wrap;">
        <button id="positionBtn" class="theme-toggle" data-tip-pos="bottom" data-tip="💼 내 매수 정보를 입력하면&#10;현재 평가손익·시나리오·물타기 효과를&#10;상세히 분석합니다.">💼 포지션</button>
        <button id="watchlistBtn" class="theme-toggle" data-tip-pos="bottom" data-tip="📋 저장한 종목들을&#10;카드 그리드로 한눈에 비교합니다.">📋 워치리스트 <span id="watchBadge" style="display:none; background:var(--accent); color:#fff; border-radius:999px; padding:1px 6px; font-size:10px; margin-left:4px;">0</span></button>
        <button id="savedBtn" class="theme-toggle" data-tip-pos="bottom" data-tip="💾 현재 분석을 저장하고 나중에 불러옵니다.">💾 저장</button>
        <button id="shareBtn" class="theme-toggle" data-tip-pos="bottom" data-tip="📷 분석 결과를 사진(PNG)으로 캡처합니다.">📷 공유</button>
        <button id="settingsBtn" class="theme-toggle" data-tip-pos="bottom" data-tip="⚙️ ATR 배수, MA 기간, 손익비, 세금/수수료 등&#10;분석 옵션을 사용자 맞춤 설정합니다.">⚙️</button>
        <button id="tourBtn" class="theme-toggle" data-tip-pos="bottom" data-tip="🎓 사용법을 단계별로 안내받습니다.">🎓</button>
        <button id="printBtn" class="theme-toggle" data-tip-pos="bottom" data-tip="🖨️ 분석 결과를 A4 인쇄/PDF로 저장합니다.">🖨️</button>
        <button id="themeToggle" class="theme-toggle">☀️</button>
      </div>
    </header>

    <div id="banner" class="banner"></div>

    <!-- 입력 폼 (스크롤 시 상단 고정) -->
    <div class="card sticky-input" id="inputCard">
      <!-- 미니 모드 (모바일/스크롤 시) -->
      <div class="mini-bar">
        <span class="mini-title" id="miniTitle">📊 분석 시작</span>
        <span class="mini-pct" id="miniPct"></span>
        <button class="btn" id="miniRunBtn">📊</button>
        <button class="btn ghost" id="miniExpandBtn">⬇</button>
      </div>

      <div class="form-grid">
        <div>
          <label>종목명 (표시용)</label>
          <div style="position:relative;">
            <div class="recent-wrap" style="display:block;">
              <input id="symbol" type="text" placeholder="예: 삼성전자" value="" autocomplete="off" />
              <div class="recent-menu" id="recentMenu"></div>
            </div>
          </div>
        </div>
        <div>
          <label>종목 코드 (선택, KRX 갱신용)</label>
          <input id="symbolCode" type="text" placeholder="예: 005930" maxlength="7" pattern="[0-9A-Za-z]*" autocomplete="off" />
        </div>
        <div>
          <label>봉 종류</label>
          <div class="radio-group" id="intervalGroup">
            <div class="pill active" data-v="DAILY">일봉</div>
            <div class="pill" data-v="WEEKLY">주봉</div>
            <div class="pill" data-v="MONTHLY">월봉</div>
          </div>
        </div>
        <div>
          <label>시작일 (필터)</label>
          <input id="startDate" type="date" />
        </div>
        <div>
          <label>종료일 (필터)</label>
          <input id="endDate" type="date" />
        </div>
        <div style="display:flex; align-items:flex-end;">
          <button id="runBtn" class="btn" style="width:100%;">
            <span>📊 분석 시작</span>
            <span id="spinner" class="spinner" style="margin-left:8px; vertical-align:middle;"></span>
          </button>
        </div>
      </div>
      <div class="row" style="margin-top:10px;">
        <button id="openDataBtn" class="btn">📥 데이터 입력 / 변경</button>
        <button id="quickEntryBtn" class="btn ghost" data-tip-pos="bottom" data-tip="🔥 오늘 한 줄만 추가/갱신&#10;전체 KRX 데이터를 다시 받지 않고&#10;오늘 시·고·저·종·거래량만 입력해&#10;기존 데이터에 즉시 병합합니다.">🔥 오늘 종가 빠른 입력</button>
        <button id="krxLinkBtn" class="btn ghost" data-tip-pos="bottom" data-tip="🔗 KRX 정보데이터시스템&#10;개별종목 시세 추이 페이지로 이동합니다.&#10;종목코드가 있으면 함께 안내됩니다.">🔗 KRX에서 갱신</button>
        <button id="realtimeBtn" class="btn ghost" data-tip-pos="bottom" data-tip="🔴 실시간 가격 가져오기&#10;Stooq · Yahoo Finance에서 자동 조회&#10;(15~20분 지연 가능, 무료 데이터)&#10;종목코드 필요">🔴 실시간 가격</button>
        <button id="collapseAllBtn" class="btn ghost" data-tip-pos="bottom" data-tip="📂 모든 분석 카드를 한 번에 접거나 펼칩니다.&#10;개별 카드 제목을 클릭해 따로 접을 수도 있습니다.">📁 모두 접기</button>
        <button id="sampleBtn" class="btn ghost">샘플</button>
        <button id="clearBtn" class="btn ghost">데이터 지우기</button>
        <span class="data-status empty" id="dataStatus">⚠️ 데이터 없음 — [데이터 입력]을 먼저 클릭하세요</span>
      </div>
    </div>

    <!-- 빠른 입력 모달 -->
    <div id="quickModal" class="modal" role="dialog" aria-modal="true">
      <div class="modal-content" style="max-width: 560px;">
        <div class="modal-header">
          <h2>🔥 오늘 종가 빠른 입력</h2>
          <button class="modal-close" id="quickCloseBtn" aria-label="닫기">×</button>
        </div>
        <div class="modal-body">
          <div class="quick-info">
            <b>📌 사용 시점</b> — 어제까지 데이터로 분석해놨는데, 오늘 급등/급락이 와서 즉시 갱신하고 싶을 때.
            전체 KRX 데이터를 다시 받을 필요 없이 오늘 한 줄만 추가하면 매수가·손절가·목표가가 다시 계산됩니다.
          </div>
          <div class="quick-form">
            <div>
              <label>일자</label>
              <input id="qe_date" type="date" />
            </div>
            <div>
              <label>종가 <span style="color:var(--bad)">*</span></label>
              <input id="qe_close" type="number" step="any" placeholder="필수" />
            </div>
            <div>
              <label>시가 (선택)</label>
              <input id="qe_open" type="number" step="any" placeholder="비우면 종가로" />
            </div>
            <div>
              <label>고가 (선택)</label>
              <input id="qe_high" type="number" step="any" placeholder="비우면 자동" />
            </div>
            <div>
              <label>저가 (선택)</label>
              <input id="qe_low" type="number" step="any" placeholder="비우면 자동" />
            </div>
            <div>
              <label>거래량 (선택)</label>
              <input id="qe_volume" type="number" step="any" placeholder="0" />
            </div>
          </div>
          <div class="hint" style="margin-top:8px;">💡 <b>종가만 입력해도 OK</b>입니다. 시·고·저는 종가로 자동 채워지고, 같은 일자가 이미 있으면 교체됩니다.</div>
          <div class="hint" style="margin-top:4px;">⚡ 빠른 시뮬레이션: 종가에 예상 가격만 넣고 [추가 후 분석]을 누르면 그 가격 기준으로 매매 레벨이 어떻게 바뀔지 즉시 확인할 수 있습니다.</div>
        </div>
        <div class="modal-footer">
          <button class="btn ghost" id="quickCancelBtn">취소</button>
          <button class="btn" id="quickApplyBtn">📊 추가 후 분석</button>
        </div>
      </div>
    </div>

    <!-- 가격 알림 / 오래된 데이터 영역 -->
    <div id="alertArea"></div>
    <div id="staleArea"></div>

    <!-- 데이터 입력 모달 -->
    <div id="dataModal" class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <div class="modal-content">
        <div class="modal-header">
          <h2 id="modalTitle">📥 KRX 데이터 입력</h2>
          <button class="modal-close" id="modalCloseBtn" aria-label="닫기">×</button>
        </div>
        <div class="modal-body">
          <details open class="guide">
            <summary>📘 KRX 데이터 가져오는 방법 (펼치기/접기)</summary>
            <div class="guide-body">
              <p><b>✅ 1단계 — KRX 정보데이터시스템 접속</b></p>
              <ul>
                <li><a href="http://data.krx.co.kr/" target="_blank" rel="noopener">data.krx.co.kr</a> 접속</li>
                <li>좌측 메뉴 → <b>[기본 통계] → [주식] → [종목시세] → [개별종목 시세 추이]</b>
                  (또는 검색창에 "개별종목 시세 추이" 검색)</li>
              </ul>

              <p><b>✅ 2단계 — 종목·기간 조회</b></p>
              <ul>
                <li>종목코드/종목명 입력 (예: <code>005930</code> 삼성전자)</li>
                <li>조회 기간 설정 → <b>[조회]</b> 버튼 클릭</li>
              </ul>

              <p><b>✅ 3단계 — 엑셀 다운로드 (우측 상단 다운로드 아이콘)</b></p>
              <ul>
                <li>화면 우측 상단의 <b>Excel 아이콘(↓)</b> 클릭 → <code>.xls</code> 파일 다운로드</li>
                <li>다운로드한 파일을 <b>엑셀(또는 LibreOffice/구글시트)</b>로 엽니다.</li>
              </ul>

              <p><b>✅ 4단계 — 표 영역 복사 → 아래에 붙여넣기</b></p>
              <ul>
                <li>엑셀에서 <b>헤더(일자, 종가, 대비, …)부터 마지막 행까지</b> 드래그 선택</li>
                <li><kbd>Ctrl + C</kbd> 로 복사</li>
                <li>아래 텍스트 영역을 클릭 후 <kbd>Ctrl + V</kbd></li>
                <li>우측 하단 <b>[저장 및 분석]</b> 버튼 클릭</li>
              </ul>

              <p><b>📄 자동 인식되는 컬럼</b> (KRX 기본 형식 그대로 OK)</p>
              <div class="col-list">
                <span><b>일자</b> (필수)</span>
                <span><b>종가</b> (필수)</span>
                <span>대비</span>
                <span>등락률(%)</span>
                <span><b>시가</b> (필수)</span>
                <span><b>고가</b> (필수)</span>
                <span><b>저가</b> (필수)</span>
                <span>거래량</span>
                <span>거래대금</span>
                <span>시가총액</span>
                <span>상장주식수</span>
              </div>
              <div class="hint">※ 컬럼 순서가 달라도 헤더 이름으로 자동 매칭됩니다. 숫자에 포함된 콤마·+/-·▲▼·% 기호는 자동 정리됩니다. 일자는 <code>YYYY/MM/DD</code>, <code>YYYY-MM-DD</code>, <code>YYYY.MM.DD</code> 모두 지원.</div>

              <p><b>💡 팁</b></p>
              <ul>
                <li>주봉/월봉은 일봉 데이터를 자동 리샘플링하여 생성합니다 — 일봉으로 받아 한 번만 붙여넣으면 됩니다.</li>
                <li>붙여넣은 데이터는 브라우저(localStorage)에 저장되어 새로고침해도 유지됩니다.</li>
                <li>엑셀이 없다면 KRX 페이지에서 표를 직접 드래그해 복사·붙여넣기 해도 됩니다.</li>
              </ul>
            </div>
          </details>

          <label style="margin-top:12px;">⬇️ 여기에 KRX 표를 붙여넣으세요 (Ctrl+V)</label>
          <textarea id="krxInput" class="input-area" style="min-height:200px;" placeholder="일자	종가	대비	등락률	시가	고가	저가	거래량	거래대금	시가총액	상장주식수
2024/12/30	53,400	▼1,100	-2.02	54,500	54,700	53,300	17,123,456	915,678,901,234	318,798,000,000,000	5,969,782,550
2024/12/27	54,500	▲500	+0.93	54,000	54,800	53,800	14,234,567	773,456,789,012	325,353,150,000,000	5,969,782,550
..."></textarea>
          <div class="hint" id="parseHint">붙여넣은 후 자동으로 행 수가 표시됩니다.</div>
        </div>
        <div class="modal-footer">
          <span class="hint" id="modalHint">붙여넣기 후 [저장 및 분석]을 누르세요.</span>
          <button class="btn ghost" id="modalCancelBtn">닫기</button>
          <button class="btn" id="modalApplyBtn">📊 저장 및 분석</button>
        </div>
      </div>
    </div>

    <!-- 설정 모달 -->
    <div id="settingsModal" class="modal" role="dialog" aria-modal="true">
      <div class="modal-content" style="max-width: 600px;">
        <div class="modal-header">
          <h2>⚙️ 설정</h2>
          <button class="modal-close" id="settingsCloseBtn">×</button>
        </div>
        <div class="modal-body">
          <div class="hint" style="margin-bottom:8px;">변경 시 즉시 적용되며 브라우저에 저장됩니다.</div>

          <div class="setting-row">
            <label class="s-name">📏 손절가 ATR 배수</label>
            <div class="s-desc">평단 - ATR × 배수 + 최근 저점 중 더 보수적인 값. 작을수록 민감, 클수록 여유.</div>
            <select id="set_atrMult">
              <option value="1.5">1.5배 (민감)</option>
              <option value="2" selected>2.0배 (기본)</option>
              <option value="2.5">2.5배 (여유)</option>
              <option value="3">3.0배 (느슨)</option>
            </select>
          </div>

          <div class="setting-row">
            <label class="s-name">🎯 1차 목표가 ATR 배수</label>
            <div class="s-desc">단기 익절 기준. 작을수록 빠른 익절.</div>
            <select id="set_target1Mult">
              <option value="2">2배 (빠른 익절)</option>
              <option value="3" selected>3배 (기본)</option>
              <option value="4">4배 (장기)</option>
              <option value="5">5배 (강한 추세)</option>
            </select>
          </div>

          <div class="setting-row">
            <label class="s-name">🚀 2차 목표가 ATR 배수</label>
            <select id="set_target2Mult">
              <option value="4">4배</option>
              <option value="5" selected>5배 (기본)</option>
              <option value="7">7배</option>
              <option value="10">10배 (대박)</option>
            </select>
          </div>

          <div class="setting-row">
            <label class="s-name">⚖️ 손익비 임계값</label>
            <div class="s-desc">이 값 이상이면 ✅ 양호로 평가</div>
            <select id="set_rrThreshold">
              <option value="1.5">1.5:1</option>
              <option value="2" selected>2:1 (권장)</option>
              <option value="3">3:1</option>
            </select>
          </div>

          <div class="setting-row">
            <label class="s-name">📊 이동평균선 기간</label>
            <div class="s-desc">차트에 표시되는 4개 이평선의 기간</div>
            <div style="display:flex; gap:6px;">
              <input type="number" id="set_ma1" min="2" max="200" step="1" placeholder="MA1" />
              <input type="number" id="set_ma2" min="2" max="200" step="1" placeholder="MA2" />
              <input type="number" id="set_ma3" min="2" max="200" step="1" placeholder="MA3" />
              <input type="number" id="set_ma4" min="2" max="200" step="1" placeholder="MA4" />
            </div>
          </div>

          <div class="setting-row">
            <label class="s-name">💸 세금 / 수수료 자동 반영</label>
            <div class="s-desc">한국 주식 거래세(0.18%) + 증권사 수수료 반영하여 실손익비 계산</div>
            <div class="checkbox-row">
              <input type="checkbox" id="set_useFee" />
              <label for="set_useFee" style="cursor:pointer;">활성화</label>
            </div>
