/* --- 탭 1: 포지션 손익 분석 (요약) --- */
function renderPosSummary(ctx) {
  const { avgPrice, qty, current, L } = ctx;
  const cost = avgPrice * qty;
  const value = current * qty;
  const pl = value - cost;
  const plPct = (current - avgPrice) / avgPrice * 100;
  const plClass = pl >= 0 ? 'profit' : 'loss';
  const plColor = pl >= 0 ? 'pos' : 'neg';
  const advice = positionAdvice(plPct, L);
  const lossOnStop = L ? (L.stopLoss - avgPrice) * qty : 0;
  const gainOnT1 = L ? (L.target1 - avgPrice) * qty : 0;
  const gainOnT2 = L ? (L.target2 - avgPrice) * qty : 0;

  return `
